<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Core" Version="1.2.0" />
    <!-- Stripe SDK — phase 3 of the billing system. Used for Checkout sessions, Customer
         management, and webhook event verification. -->
    <PackageReference Include="Stripe.net" Version="47.4.0" />
    <!-- QuestPDF — phase 9 invoice PDF rendering. Community license fine for non-commercial
         use; flip to Professional license at deploy time if revenue ≥ $1M. -->
    <PackageReference Include="QuestPDF" Version="2024.7.3" />
    <!-- StackExchange.Redis — CRM-AI-Service bridge via Redis Streams (XADD / XREADGROUP). -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatCRM.Application\ChatCRM.Application.csproj" />
    <ProjectReference Include="..\ChatCRM.Persistence\ChatCRM.Persistence.csproj" />
  </ItemGroup>

</Project>
