@*
    Vertical labeled rail used on every dashboard page (Inbox / Numbers / Settings).
    Pass the active section name so the matching link gets highlighted.

    Restyled to the warm parchment / serif aesthetic of the public landing page.
    Class names (.rail, .rail-link, .active, etc.) and href targets are unchanged
    so JS and routing behavior stay identical.

    Usage:
        @await Html.PartialAsync("_DashboardRail", "inbox")        // chats
        @await Html.PartialAsync("_DashboardRail", "numbers")      // /dashboard/whatsapp
        @await Html.PartialAsync("_DashboardRail", "settings")     // /dashboard/settings
*@
@using ChatCRM.Domain.Entities
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthZ
@model string
@inject Microsoft.Extensions.Localization.IStringLocalizer T
@{
    var active = (Model ?? string.Empty).ToLowerInvariant();
    string Cls(string name) => active == name ? "rail-link active" : "rail-link";

    // Billing nav item is gated on the BillingView claim — Agents shouldn't see it at all.
    var canSeeBilling = User.Identity?.IsAuthenticated == true
        && (await AuthZ.AuthorizeAsync(User, null, new[] { new ChatCRM.Infrastructure.Authorization.PermissionRequirement(Permissions.BillingView) })).Succeeded;
    var canSeeTemplates = User.Identity?.IsAuthenticated == true
        && (await AuthZ.AuthorizeAsync(User, null, new[] { new ChatCRM.Infrastructure.Authorization.PermissionRequirement(Permissions.TemplatesView) })).Succeeded;
    var canSeeAgents = User.Identity?.IsAuthenticated == true
        && (await AuthZ.AuthorizeAsync(User, null, new[] { new ChatCRM.Infrastructure.Authorization.PermissionRequirement(Permissions.AgentsView) })).Succeeded;
    var canSeePlatformAdmin = User.Identity?.IsAuthenticated == true
        && (await AuthZ.AuthorizeAsync(User, null, new[] { new ChatCRM.Infrastructure.Authorization.PermissionRequirement(Permissions.PlatformAdmin) })).Succeeded;
}

<aside class="rail">
    <a class="rail-brand" asp-controller="Home" asp-action="Index" title="ChatCRM">
        <svg class="rail-brand-leaf" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 2C7 6 4 10 4 14a8 8 0 0 0 16 0c0-4-3-8-8-12zm0 18c-2.6 0-4.5-1.6-5.4-3.8 1.2.5 2.6.8 4 .8 3.1 0 5.4-1.6 6.4-3.5C16.5 17 14.5 20 12 20z"/>
        </svg>
        <span class="rail-brand-text">ChatCRM</span>
    </a>

    <nav class="rail-nav">
        <a class="@Cls("dashboard")" href="/dashboard" title="@T["Rail.Dashboard"]">
            @await Html.PartialAsync("_Icon", new IconModel("layout-dashboard", size: 20, ariaLabel: T["Rail.Dashboard"].Value))
            <span class="rail-label">@T["Rail.Dashboard"]</span>
        </a>
        <a class="@Cls("inbox")" href="/dashboard/chats" title="@T["Rail.Inbox"]">
            @await Html.PartialAsync("_Icon", new IconModel("inbox", size: 20, ariaLabel: T["Rail.Inbox"].Value))
            <span class="rail-label">@T["Rail.Inbox"]</span>
        </a>
        <a class="@Cls("contacts")" href="/dashboard/contacts" title="@T["Rail.Contacts"]">
            @await Html.PartialAsync("_Icon", new IconModel("users", size: 20, ariaLabel: T["Rail.Contacts"].Value))
            <span class="rail-label">@T["Rail.Contacts"]</span>
        </a>
        <a class="@Cls("pipeline")" href="/dashboard/pipeline" title="@T["Rail.Pipeline"]">
            @await Html.PartialAsync("_Icon", new IconModel("kanban", size: 20, ariaLabel: T["Rail.Pipeline"].Value))
            <span class="rail-label">@T["Rail.Pipeline"]</span>
        </a>
        @if (canSeeBilling)
        {
            <a class="@Cls("billing")" href="/dashboard/billing" title="@T["Rail.Billing"]">
                @await Html.PartialAsync("_Icon", new IconModel("wallet", size: 20, ariaLabel: T["Rail.Billing"].Value))
                <span class="rail-label">@T["Rail.Billing"]</span>
            </a>
        }
        @if (canSeeTemplates)
        {
            <a class="@Cls("templates")" href="/dashboard/templates" title="@T["Rail.Templates"]">
                @await Html.PartialAsync("_Icon", new IconModel("file-text", size: 20, ariaLabel: T["Rail.Templates"].Value))
                <span class="rail-label">@T["Rail.Templates"]</span>
            </a>
        }
        @if (canSeeAgents)
        {
            <a class="@Cls("agents")" href="/dashboard/agents" title="@T["Rail.Agents"]">
                @await Html.PartialAsync("_Icon", new IconModel("smile-plus", size: 20, ariaLabel: T["Rail.Agents"].Value))
                <span class="rail-label">@T["Rail.Agents"]</span>
            </a>
        }
        @if (canSeePlatformAdmin)
        {
            <a class="@Cls("platform-admin")" href="/dashboard/platform-admin" title="@T["Rail.PlatformAdmin"]">
                @await Html.PartialAsync("_Icon", new IconModel("shield", size: 20, ariaLabel: T["Rail.PlatformAdmin"].Value))
                <span class="rail-label">@T["Rail.PlatformAdmin"]</span>
            </a>
            <a class="@Cls("audit")" href="/dashboard/audit" title="@T["Rail.Audit"]">
                @await Html.PartialAsync("_Icon", new IconModel("eye", size: 20, ariaLabel: T["Rail.Audit"].Value))
                <span class="rail-label">@T["Rail.Audit"]</span>
            </a>
        }
        <div class="rail-link-wrap" id="settingsRailWrap">
            <button type="button"
                    class="@Cls("settings")"
                    id="settingsRailBtn"
                    title="@T["Rail.Settings"]"
                    aria-haspopup="true"
                    aria-expanded="false">
                @await Html.PartialAsync("_Icon", new IconModel("settings", size: 20, ariaLabel: T["Rail.Settings"].Value))
                <span class="rail-label">@T["Rail.Settings"]</span>
            </button>
            <div class="settings-popover d-none" id="settingsPopover" role="menu">
                <a class="settings-popover-item" href="/Account/Profile" role="menuitem">
                    @await Html.PartialAsync("_Icon", new IconModel("user", size: 16))
                    <span>@T["Rail.PersonalSettings"]</span>
                </a>
                <a class="settings-popover-item" href="/dashboard/settings/channels" role="menuitem">
                    @await Html.PartialAsync("_Icon", new IconModel("smartphone", size: 16))
                    <span>@T["Rail.Channels"]</span>
                </a>
                <a class="settings-popover-item" href="/dashboard/settings/users" role="menuitem">
                    @await Html.PartialAsync("_Icon", new IconModel("users", size: 16))
                    <span>@T["Rail.UserManagement"]</span>
                </a>
            </div>
        </div>
    </nav>

    <div class="rail-bottom">
        @await Html.PartialAsync("_LanguageSwitcher")
        <a asp-controller="Account" asp-action="Profile" class="rail-link" title="@T["Rail.Profile"]">
            @await Html.PartialAsync("_Icon", new IconModel("user", size: 20, ariaLabel: T["Rail.Profile"].Value))
            <span class="rail-label">@T["Rail.Profile"]</span>
        </a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="rail-link" title="@T["Rail.SignOut"]">
                @await Html.PartialAsync("_Icon", new IconModel("log-out", size: 20, ariaLabel: T["Rail.SignOut"].Value))
                <span class="rail-label">@T["Rail.SignOut"]</span>
            </button>
        </form>
    </div>
</aside>

<script>
    (function () {
        const btn  = document.getElementById('settingsRailBtn');
        const menu = document.getElementById('settingsPopover');
        if (!btn || !menu) return;

        btn.addEventListener('click', () => {
            // No stopPropagation — letting the click bubble means other open popovers (e.g.
            // the language switcher) can close themselves via their own document-level
            // outside-click listeners.
            const open = !menu.classList.contains('d-none');
            menu.classList.toggle('d-none', open);
            btn.setAttribute('aria-expanded', String(!open));
        });

        // Close on outside click
        document.addEventListener('click', (e) => {
            const wrap = document.getElementById('settingsRailWrap');
            if (wrap && !wrap.contains(e.target)) {
                menu.classList.add('d-none');
                btn.setAttribute('aria-expanded', 'false');
            }
        });

        // Close on Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                menu.classList.add('d-none');
                btn.setAttribute('aria-expanded', 'false');
            }
        });
    })();
</script>
