@model ErrorViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer T
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Error.Title"].Value;
    ViewData["AuthCardClass"] = "auth-card-wide";
}

<h1 class="auth-heading">@T["Error.Heading"]</h1>
<p class="auth-sub">@T["Error.SubHeading"]</p>

<div class="auth-static-body">
    @if (Model.ShowRequestId)
    {
        <p><strong>@T["Error.RequestId"]</strong> <code>@Model.RequestId</code></p>
    }
</div>

<div class="auth-btn-row">
    <a href="/" class="auth-btn auth-btn-secondary">@T["Auth.AccessDenied.BackHome"]</a>
</div>
