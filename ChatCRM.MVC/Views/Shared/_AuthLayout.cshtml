@*
    Auth / static-page layout. Restyled to the warm parchment / sage-forest aesthetic
    of the landing page (palette + Fraunces serif headings, Inter body). All view names,
    classes referenced by JS and layout slots are unchanged.

    Used by Login, Register, ForgotPassword, ResetPassword, VerifyEmail, AccessDenied,
    Privacy, and Error.
*@
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer T
@inject ChatCRM.MVC.Localization.JsonStringLocalizer.ResourceCache LocalizationCache

@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var translations = LocalizationCache.Load(culture) ?? LocalizationCache.Load("en") ?? new Dictionary<string, string>();
    var translationsJson = System.Text.Json.JsonSerializer.Serialize(translations);
    var htmlLang = culture;
    var htmlDir  = (culture is "ar" or "he" or "fa" or "ur") ? "rtl" : "ltr";

    var statusMessage = TempData["StatusMessage"] as string;
    var statusType    = (TempData["StatusType"] as string ?? "info").ToLowerInvariant();
    var alertClass    = statusType switch
    {
        "success" => "auth-alert-success",
        "warning" => "auth-alert-warning",
        "danger"  => "auth-alert-danger",
        "error"   => "auth-alert-danger",
        _          => "auth-alert-info"
    };

    var mainClass = ViewData["AuthMainClass"] as string ?? string.Empty;
    var asideContent = ViewData["AuthAside"] as Func<object, Microsoft.AspNetCore.Html.IHtmlContent>;
    var topRightContent = ViewData["AuthTopRight"] as Func<object, Microsoft.AspNetCore.Html.IHtmlContent>;
    var isSplit = mainClass.Contains("auth-main-split");
}
<!DOCTYPE html>
<html lang="@htmlLang" dir="@htmlDir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ChatCRM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css"  asp-append-version="true" />
    <script>
        window.__i18n__        = @Html.Raw(translationsJson);
        window.__i18nCulture__ = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(culture));
    </script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
</head>
<body class="auth-shell @(isSplit ? "auth-shell-split" : "")">

    @if (!isSplit)
    {
        <header class="auth-topbar">
            <a class="auth-brand" href="/" title="ChatCRM">
                <span class="auth-brand-mark">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M12 2C7 6 4 10 4 14a8 8 0 0 0 16 0c0-4-3-8-8-12zm0 18c-2.6 0-4.5-1.6-5.4-3.8 1.2.5 2.6.8 4 .8 3.1 0 5.4-1.6 6.4-3.5C16.5 17 14.5 20 12 20z"/>
                    </svg>
                </span>
                <span>ChatCRM</span>
            </a>
        </header>
    }

    <main class="auth-main @mainClass">
        @if (asideContent != null)
        {
            <div class="auth-form-col">
                <div class="auth-form-topbar">
                    <a class="auth-brand auth-brand-inline" href="/" title="ChatCRM">
                        <span class="auth-brand-mark">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M12 2C7 6 4 10 4 14a8 8 0 0 0 16 0c0-4-3-8-8-12zm0 18c-2.6 0-4.5-1.6-5.4-3.8 1.2.5 2.6.8 4 .8 3.1 0 5.4-1.6 6.4-3.5C16.5 17 14.5 20 12 20z"/>
                            </svg>
                        </span>
                        <span>ChatCRM</span>
                    </a>
                    @if (topRightContent != null)
                    {
                        <div class="auth-form-topright">@topRightContent(null)</div>
                    }
                </div>
                <div class="auth-card @ViewData["AuthCardClass"]">
                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="auth-alert @alertClass" role="alert">@statusMessage</div>
                    }

                    @RenderBody()
                </div>
            </div>
            <aside class="auth-aside">
                @asideContent(null)
            </aside>
        }
        else
        {
            <div class="auth-card @ViewData["AuthCardClass"]">
                @if (!string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="auth-alert @alertClass" role="alert">@statusMessage</div>
                }

                @RenderBody()
            </div>
        }
    </main>

    <footer class="auth-footer-bar">
        @await Html.PartialAsync("_LanguageSwitcher")
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
