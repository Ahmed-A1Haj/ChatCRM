@model UpdateProfileDto
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer T
@inject ChatCRM.MVC.Localization.JsonStringLocalizer.ResourceCache LocalizationCache

@{
    Layout = null;
    ViewData["Title"] = T["Profile.Title"].Value;

    var displayName = string.Join(" ", new[] { Model.FirstName, Model.LastName }.Where(x => !string.IsNullOrWhiteSpace(x)));
    if (string.IsNullOrWhiteSpace(displayName)) { displayName = Model.Email; }

    var initialsSource = !string.IsNullOrWhiteSpace(displayName) ? displayName : "U";
    var initials = string.Concat(initialsSource
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
    if (string.IsNullOrWhiteSpace(initials)) { initials = "U"; }

    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var translations = LocalizationCache.Load(culture) ?? LocalizationCache.Load("en") ?? new Dictionary<string, string>();
    var translationsJson = System.Text.Json.JsonSerializer.Serialize(translations);
    var htmlLang = culture;
    var htmlDir  = (culture is "ar" or "he" or "fa" or "ur") ? "rtl" : "ltr";

    var statusMessage = TempData["StatusMessage"] as string;
    var statusType    = (TempData["StatusType"] as string ?? "info").ToLowerInvariant();
    var changePasswordOpen = TempData["ChangePasswordOpen"] as bool? ?? false;
    var cpCurrentErr = TempData["ChangePasswordError_CurrentPassword"] as string;
    var cpNewErr     = TempData["ChangePasswordError_NewPassword"]     as string;
    var cpConfirmErr = TempData["ChangePasswordError_ConfirmNewPassword"] as string;
}
<!DOCTYPE html>
<html lang="@htmlLang" dir="@htmlDir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ChatCRM</title>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css"  asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <script>
        window.__i18n__        = @Html.Raw(translationsJson);
        window.__i18nCulture__ = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(culture));
    </script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
</head>
<body class="inbox-shell">

@await Html.PartialAsync("_DashboardRail", "settings")

<main class="profile-main">
    <div class="profile-container">
        <header class="profile-page-head">
            <h1 class="profile-page-title">@T["Profile.Title"]</h1>
            <p class="profile-page-sub">@T["Profile.Sub"]</p>
        </header>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="auth-alert auth-alert-@(statusType == "error" ? "danger" : statusType)" role="alert">@statusMessage</div>
        }

        <section class="profile-card">
            <div class="profile-card-head">
                <div class="profile-avatar" data-profile-preview-container>
                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                    {
                        <img src="@Model.ProfileImagePath" alt="@displayName" class="profile-avatar-img" data-profile-preview-image />
                        <span class="profile-avatar-fallback d-none" data-profile-preview-fallback>@initials</span>
                    }
                    else
                    {
                        <img src="" alt="" class="profile-avatar-img d-none" data-profile-preview-image />
                        <span class="profile-avatar-fallback" data-profile-preview-fallback>@initials</span>
                    }
                </div>
                <div class="profile-card-head-text">
                    <h2 class="profile-card-name">@displayName</h2>
                    <p class="profile-card-email">@Model.Email</p>
                    <span class="profile-email-pill @(Model.EmailConfirmed ? "is-verified" : "is-pending")">
                        @(Model.EmailConfirmed ? T["Profile.EmailVerified"].Value : T["Profile.EmailPending"].Value)
                    </span>
                </div>
            </div>
        </section>

        @* ── Personal info & email ─────────────────────────────────────── *@
        <section class="profile-card">
            <header class="profile-section-head">
                <h2>@T["Profile.EditTitle"]</h2>
                <p>@T["Profile.EditSub"]</p>
            </header>

            <form asp-action="Profile" method="post" enctype="multipart/form-data" novalidate data-loading-form>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

                <div class="profile-grid">
                    <div class="auth-field">
                        <label asp-for="FirstName"></label>
                        <input asp-for="FirstName" class="auth-input" autocomplete="given-name" placeholder="@T["Profile.FirstNamePlaceholder"]" />
                        <span asp-validation-for="FirstName" class="auth-error"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="LastName"></label>
                        <input asp-for="LastName" class="auth-input" autocomplete="family-name" placeholder="@T["Profile.LastNamePlaceholder"]" />
                        <span asp-validation-for="LastName" class="auth-error"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="auth-input" autocomplete="email" placeholder="@T["Profile.EmailPlaceholder"]" />
                        <span asp-validation-for="Email" class="auth-error"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="PhoneNumber"></label>
                        <input asp-for="PhoneNumber" class="auth-input" autocomplete="tel" placeholder="@T["Profile.PhonePlaceholder"]" />
                        <span asp-validation-for="PhoneNumber" class="auth-error"></span>
                    </div>
                </div>

                <div class="profile-upload">
                    <div class="profile-upload-text">
                        <h3>@T["Profile.Photo.Title"]</h3>
                        <p>@T["Profile.Photo.Sub"]</p>
                    </div>
                    <div class="auth-field">
                        <label for="profileImage">@T["Profile.Photo.UploadLabel"]</label>
                        <input id="profileImage" name="profileImage" type="file" class="auth-input" accept=".jpg,.jpeg,.png,.webp" data-profile-image-input />
                        <p class="auth-hint">@T["Profile.Photo.Hint"]</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                    {
                        <label class="auth-check">
                            <input asp-for="RemoveProfileImage" />
                            <span>@T["Profile.Photo.Remove"]</span>
                        </label>
                    }
                </div>

                <div class="profile-actions">
                    <button type="submit" class="auth-btn auth-btn-primary" data-loading-text="@T["Profile.Saving"]">@T["Profile.SaveChanges"]</button>
                </div>
            </form>
        </section>

        @* ── Change password ──────────────────────────────────────────── *@
        <section class="profile-card" id="changePasswordSection">
            <header class="profile-section-head">
                <h2>@T["Profile.Password.Title"]</h2>
                <p>@T["Profile.Password.Sub"]</p>
            </header>

            <form asp-action="ChangePassword" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="profile-grid">
                    <div class="auth-field">
                        <label for="CurrentPassword">@T["Profile.Password.Current"]</label>
                        <div class="auth-password">
                            <input id="CurrentPassword" name="CurrentPassword" type="password" class="auth-input @(string.IsNullOrEmpty(cpCurrentErr) ? "" : "is-invalid")" autocomplete="current-password" placeholder="@T["Profile.Password.CurrentPlaceholder"]" />
                            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="@T["Auth.Login.ShowPassword"]" aria-pressed="false">
                                <span class="password-toggle-text">@T["Auth.Login.Show"]</span>
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(cpCurrentErr))
                        {
                            <span class="auth-error">@cpCurrentErr</span>
                        }
                    </div>
                    <div class="auth-field">
                        <label for="NewPassword">@T["Profile.Password.New"]</label>
                        <div class="auth-password">
                            <input id="NewPassword" name="NewPassword" type="password" class="auth-input @(string.IsNullOrEmpty(cpNewErr) ? "" : "is-invalid")" autocomplete="new-password" placeholder="@T["Profile.Password.NewPlaceholder"]" />
                            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="@T["Auth.Login.ShowPassword"]" aria-pressed="false">
                                <span class="password-toggle-text">@T["Auth.Login.Show"]</span>
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(cpNewErr))
                        {
                            <span class="auth-error">@cpNewErr</span>
                        }
                        <p class="auth-hint">@T["Auth.Register.PasswordHint"]</p>
                    </div>
                    <div class="auth-field">
                        <label for="ConfirmNewPassword">@T["Profile.Password.Confirm"]</label>
                        <div class="auth-password">
                            <input id="ConfirmNewPassword" name="ConfirmNewPassword" type="password" class="auth-input @(string.IsNullOrEmpty(cpConfirmErr) ? "" : "is-invalid")" autocomplete="new-password" placeholder="@T["Profile.Password.ConfirmPlaceholder"]" />
                            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="@T["Auth.Login.ShowPassword"]" aria-pressed="false">
                                <span class="password-toggle-text">@T["Auth.Login.Show"]</span>
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(cpConfirmErr))
                        {
                            <span class="auth-error">@cpConfirmErr</span>
                        }
                    </div>
                </div>

                <div class="profile-actions">
                    <button type="submit" class="auth-btn auth-btn-primary">@T["Profile.Password.Submit"]</button>
                </div>
            </form>
        </section>

        @* ── Sign out ─────────────────────────────────────────────────── *@
        <section class="profile-card profile-card-quiet">
            <header class="profile-section-head">
                <h2>@T["Profile.SignOut.Title"]</h2>
                <p>@T["Profile.SignOut.Sub"]</p>
            </header>
            <form asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="auth-btn auth-btn-secondary profile-signout-btn">@T["Layout.Nav.SignOut"]</button>
            </form>
        </section>
    </div>
</main>

@if (changePasswordOpen)
{
    <script>document.addEventListener('DOMContentLoaded', () => document.getElementById('changePasswordSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));</script>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
