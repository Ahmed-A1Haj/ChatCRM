@model ForgotPasswordDto
@inject Microsoft.Extensions.Localization.IStringLocalizer T

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Auth.Forgot.Title"].Value;
}

<h1 class="auth-heading">@T["Auth.Forgot.Heading"]</h1>
<p class="auth-sub">@T["Auth.Forgot.Sub"]</p>

<form asp-action="ForgotPassword" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

    <div class="auth-field">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="auth-input" autocomplete="email" placeholder="name@company.com" />
        <span asp-validation-for="Email" class="auth-error"></span>
    </div>

    <button type="submit" class="auth-btn auth-btn-primary">@T["Auth.Forgot.Submit"]</button>
</form>

<p class="auth-footer">@T["Auth.Forgot.Footer"] <a asp-action="Login" class="auth-link">@T["Auth.Forgot.BackToSignIn"]</a>.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
