@inject Microsoft.Extensions.Localization.IStringLocalizer T
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Auth.AccessDenied.Title"].Value;
}

<h1 class="auth-heading">@T["Auth.AccessDenied.Heading"]</h1>
<p class="auth-sub">@T["Auth.AccessDenied.Sub"]</p>

<div class="auth-btn-row">
    <a asp-action="Login" class="auth-btn auth-btn-primary">@T["Auth.AccessDenied.SignInOther"]</a>
    <a href="/" class="auth-btn auth-btn-secondary">@T["Auth.AccessDenied.BackHome"]</a>
</div>
