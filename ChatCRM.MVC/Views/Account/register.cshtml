@model RegisterDto
@inject Microsoft.Extensions.Localization.IStringLocalizer T

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Auth.Register.Title"].Value;
    ViewData["AuthMainClass"] = "auth-main-split";
    ViewData["AuthCardClass"] = "auth-card-wide";
    ViewData["AuthAside"] = (Func<object, Microsoft.AspNetCore.Html.IHtmlContent>)((_) => new Microsoft.AspNetCore.Html.HtmlString(
        @"<blockquote class=""auth-aside-quote"">
            <em>“ChatCRM replaced 4 tools.</em> We close 67% more deals now.”
          </blockquote>
          <p class=""auth-aside-attr"">— Sarah Johnson, Head of Revenue</p>
          <div class=""auth-aside-visual"" aria-hidden=""true"">
            <div class=""auth-aside-visual-row"">
              <span class=""auth-aside-visual-dot"" style=""background:#25d366"">W</span>
              <span>WhatsApp</span><span>Connected</span>
            </div>
            <div class=""auth-aside-visual-row"">
              <span class=""auth-aside-visual-dot"" style=""background:linear-gradient(135deg,#feda77,#d6249f,#4f5bd5)"">I</span>
              <span>Instagram</span><span>Connected</span>
            </div>
            <div class=""auth-aside-visual-row"">
              <span class=""auth-aside-visual-dot"" style=""background:#0084ff"">M</span>
              <span>Messenger</span><span>Connected</span>
            </div>
            <div class=""auth-aside-visual-row"">
              <span class=""auth-aside-visual-dot"" style=""background:#229ed9"">T</span>
              <span>Telegram</span><span>Connected</span>
            </div>
          </div>"));
}

<h1 class="auth-heading"><em>@T["Auth.Register.Heading"]</em></h1>
<p class="auth-sub">@T["Auth.Register.Sub"]</p>

<form asp-action="Register" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

    <div class="auth-field">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="auth-input" autocomplete="email" placeholder="name@company.com" />
        <span asp-validation-for="Email" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Password"></label>
        <div class="auth-password">
            <input asp-for="Password" class="auth-input" autocomplete="new-password" placeholder="@T["Auth.Register.PasswordPlaceholder"]" />
            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="@T["Auth.Login.ShowPassword"]" aria-pressed="false">
                <span class="password-toggle-text">@T["Auth.Login.Show"]</span>
            </button>
        </div>
        <span asp-validation-for="Password" class="auth-error"></span>
        <p class="auth-hint">@T["Auth.Register.PasswordHint"]</p>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword"></label>
        <div class="auth-password">
            <input asp-for="ConfirmPassword" class="auth-input" autocomplete="new-password" placeholder="@T["Auth.Register.ConfirmPlaceholder"]" />
            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="@T["Auth.Login.ShowPassword"]" aria-pressed="false">
                <span class="password-toggle-text">@T["Auth.Login.Show"]</span>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
    </div>

    <button type="submit" class="auth-btn auth-btn-primary">@T["Auth.Register.Submit"]</button>
</form>

<p class="auth-footer">@T["Auth.Register.Footer"] <a asp-action="Login" class="auth-link">@T["Auth.Register.SignIn"]</a>.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
}
