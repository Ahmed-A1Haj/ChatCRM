@model LoginDto
@inject Microsoft.Extensions.Localization.IStringLocalizer T

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Auth.Login.Title"].Value;
}

<h1 class="auth-heading">@T["Auth.Login.Heading"]</h1>
<p class="auth-sub">@T["Auth.Login.Sub"]</p>

<form asp-action="Login" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input asp-for="ReturnUrl" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

    <div class="auth-field">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="auth-input" autocomplete="email" placeholder="@T["Auth.Login.EmailPlaceholder"]" />
        <span asp-validation-for="Email" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <div class="auth-label-row">
            <label asp-for="Password" class="auth-label">@Html.DisplayNameFor(m => m.Password)</label>
            <a asp-action="ForgotPassword" class="auth-link">@T["Auth.Login.Forgot"]</a>
        </div>
        <div class="auth-password">
            <input asp-for="Password" class="auth-input" autocomplete="current-password" placeholder="@T["Auth.Login.PasswordPlaceholder"]" />
            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="@T["Auth.Login.ShowPassword"]" aria-pressed="false">
                <span class="password-toggle-text">@T["Auth.Login.Show"]</span>
            </button>
        </div>
        <span asp-validation-for="Password" class="auth-error"></span>
    </div>

    <label class="auth-check">
        <input asp-for="RememberMe" />
        <span>@T["Auth.Login.RememberMe"]</span>
    </label>

    <button type="submit" class="auth-btn auth-btn-primary">@T["Auth.Login.Submit"]</button>
</form>

<p class="auth-footer">@T["Auth.Login.Footer"] <a asp-action="Register" class="auth-link">@T["Auth.Login.CreateOne"]</a>.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
}
