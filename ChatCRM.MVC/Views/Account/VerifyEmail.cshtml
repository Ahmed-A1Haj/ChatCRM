@model ResendConfirmationEmailDto
@inject Microsoft.Extensions.Localization.IStringLocalizer T

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Auth.Verify.Title"].Value;
    ViewData["AuthCardClass"] = "auth-card-verify";
}

<div class="auth-verify-icon" aria-hidden="true">
    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="2"/>
        <path d="m3 7 9 6 9-6"/>
    </svg>
</div>

<h1 class="auth-heading auth-heading-center">@T["Auth.Verify.Heading"]</h1>
<p class="auth-sub auth-sub-center">@T["Auth.Verify.SubBefore"] <strong>@Model.Email</strong>@T["Auth.Verify.SubAfter"]</p>
<p class="auth-hint auth-hint-center">@Html.Raw(T["Auth.Verify.DevHint"].Value)</p>

<form asp-action="ResendConfirmationEmail" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

    <div class="auth-field">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="auth-input" autocomplete="email" placeholder="name@company.com" />
        <span asp-validation-for="Email" class="auth-error"></span>
    </div>

    <button type="submit" class="auth-btn auth-btn-secondary">@T["Auth.Verify.Submit"]</button>
</form>

<p class="auth-footer">@T["Auth.Verify.Footer"] <a asp-action="Login" class="auth-link">@T["Auth.Verify.SignIn"]</a>.</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
