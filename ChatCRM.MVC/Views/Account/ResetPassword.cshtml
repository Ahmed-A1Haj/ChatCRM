@model ResetPasswordDto
@inject Microsoft.Extensions.Localization.IStringLocalizer T

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = T["Auth.Reset.Title"].Value;
}

<h1 class="auth-heading">@T["Auth.Reset.Heading"]</h1>
<p class="auth-sub">@T["Auth.Reset.Sub"]</p>

<form asp-action="ResetPassword" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input asp-for="Email" type="hidden" />
    <input asp-for="Token" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

    <div class="auth-field">
        <label asp-for="Password"></label>
        <div class="auth-password">
            <input asp-for="Password" class="auth-input" autocomplete="new-password" placeholder="@T["Auth.Reset.PasswordPlaceholder"]" />
            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="@T["Auth.Login.ShowPassword"]" data-hide-label="@T["Auth.Login.HidePassword"]" data-hide-text="@T["Auth.Login.Hide"]" aria-pressed="false">
                <span class="password-toggle-text">@T["Auth.Login.Show"]</span>
            </button>
        </div>
        <span asp-validation-for="Password" class="auth-error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword"></label>
        <div class="auth-password">
            <input asp-for="ConfirmPassword" class="auth-input" autocomplete="new-password" placeholder="@T["Auth.Reset.ConfirmPlaceholder"]" />
            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="@T["Auth.Login.ShowPassword"]" data-hide-label="@T["Auth.Login.HidePassword"]" data-hide-text="@T["Auth.Login.Hide"]" aria-pressed="false">
                <span class="password-toggle-text">@T["Auth.Login.Show"]</span>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
    </div>

    <button type="submit" class="auth-btn auth-btn-primary">@T["Auth.Reset.Submit"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
}
