@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer T
@inject ChatCRM.MVC.Localization.JsonStringLocalizer.ResourceCache LocalizationCache
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthZ
@{
    ViewData["Title"] = T["Contacts.Title"].Value;
    Layout = null;
    var team = (List<ChatCRM.Application.Chats.DTOs.TeamMemberDto>)ViewBag.TeamMembers;
    var currentUserId = (string?)ViewBag.CurrentUserId;

    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var translations = LocalizationCache.Load(culture) ?? LocalizationCache.Load("en") ?? new Dictionary<string, string>();
    var translationsJson = System.Text.Json.JsonSerializer.Serialize(translations);
    var htmlLang = culture;
    var htmlDir = (culture is "ar" or "he" or "fa" or "ur") ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@htmlLang" dir="@htmlDir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@T["Contacts.Title"] — ChatCRM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/instances.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contacts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/agents.css" asp-append-version="true" />
    <script>
        window.__i18n__ = @Html.Raw(translationsJson);
        window.__i18nCulture__ = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(culture));
        // Gates the contact-file upload/rename/delete controls. The server still enforces the
        // permission on every endpoint — this only hides controls the user can't use.
        window.__canEditContacts__ = @((await AuthZ.AuthorizeAsync(User, null, new[] { new ChatCRM.Infrastructure.Authorization.PermissionRequirement(ChatCRM.Domain.Entities.Permissions.ContactsEdit) })).Succeeded ? "true" : "false");
    </script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
</head>
<body class="inbox-shell">

@await Html.PartialAsync("_DashboardRail", "contacts")

<main class="contacts-page">

    <header class="contacts-header">
        <div class="contacts-header-title">
            <h1 class="contacts-title">@T["Contacts.Title"]</h1>
            <p class="contacts-sub">@T["Contacts.Subtitle"]</p>
        </div>
        <div class="contacts-toolbar">
            <div class="filter-search contacts-header-search">
                @await Html.PartialAsync("_Icon", new IconModel("search", size: 14, cssClass: "filter-search-icon"))
                <input type="search" id="searchInput" placeholder="@T["Contacts.SearchPlaceholder"]" />
            </div>
            <button class="btn-primary-soft has-icon" id="importBtn" type="button">
                @await Html.PartialAsync("_Icon", new IconModel("upload", size: 14))
                <span>@T["Contacts.Import"]</span>
            </button>
            <button class="btn-primary-soft has-icon" id="exportBtn" type="button">
                @await Html.PartialAsync("_Icon", new IconModel("download", size: 14))
                <span class="export-label">@T["Contacts.Export"]</span>
                <span class="btn-spinner d-none" aria-hidden="true"></span>
            </button>
        </div>
    </header>

    <section class="contacts-filters">
        <select id="lifecycleFilter" class="filter-select" aria-label="@T["Contacts.Filter.Lifecycle"]">
            <option value="">@T["Contacts.Filter.AllLifecycles"]</option>
            <option value="0">@T["Lifecycle.NewClient"]</option>
            <option value="1">@T["Lifecycle.NotResponding"]</option>
            <option value="2">@T["Lifecycle.Interested"]</option>
            <option value="3">@T["Lifecycle.Thinking"]</option>
            <option value="4">@T["Lifecycle.WantsAMeeting"]</option>
            <option value="5">@T["Lifecycle.WaitingForMeeting"]</option>
            <option value="6">@T["Lifecycle.Discussed"]</option>
            <option value="7">@T["Lifecycle.PotentialClient"]</option>
            <option value="8">@T["Lifecycle.WillMakePayment"]</option>
            <option value="9">@T["Lifecycle.WaitingForContract"]</option>
            <option value="10">@T["Lifecycle.OurClient"]</option>
        </select>

        <select id="assigneeFilter" class="filter-select" aria-label="@T["Contacts.Filter.Assignee"]">
            <option value="">@T["Contacts.Filter.AllAssignees"]</option>
            @foreach (var u in team)
            {
                <option value="@u.Id">@u.Name</option>
            }
        </select>

        <select id="statusFilter" class="filter-select" aria-label="@T["Contacts.Filter.Status"]">
            <option value="">@T["Contacts.Filter.AllStatuses"]</option>
            <option value="0">@T["Inbox.Open"]</option>
            <option value="2">@T["Inbox.Closed"]</option>
        </select>

        <select id="blockedFilter" class="filter-select" aria-label="@T["Contacts.Filter.Blocked"]">
            <option value="">@T["Contacts.Filter.ActiveAndBlocked"]</option>
            <option value="false">@T["Contacts.Filter.ActiveOnly"]</option>
            <option value="true">@T["Contacts.Filter.BlockedOnly"]</option>
        </select>
    </section>

    <section class="contacts-table-wrap">
        <table class="contacts-table" id="contactsTable">
            <thead>
                <tr>
                    <th class="col-name sortable" data-sort="name">@T["Contacts.Column.Contact"]</th>
                    <th class="col-channel">@T["Contacts.Column.Channel"]</th>
                    <th class="col-last sortable" data-sort="lastMessage">@T["Contacts.Column.LastMessage"]</th>
                    <th class="col-created sortable" data-sort="createdAt">@T["Contacts.Column.Created"]</th>
                    <th class="col-country">@T["Contacts.Column.Country"]</th>
                    <th class="col-language">@T["Contacts.Column.Language"]</th>
                    <th class="col-lifecycle">@T["Contacts.Column.Lifecycle"]</th>
                    <th class="col-assigned">@T["Contacts.Column.AssignedTo"]</th>
                    <th class="col-agent">@T["Contacts.Column.AIAgent"]</th>
                    <th class="col-status">@T["Contacts.Column.Status"]</th>
                    <th class="col-actions"></th>
                </tr>
            </thead>
            <tbody id="contactsBody">
                <tr><td colspan="11" class="contacts-empty">@T["Action.Loading"]</td></tr>
            </tbody>
        </table>
    </section>

    <footer class="contacts-pagination">
        <div class="pagination-left">
            <span class="pagination-info" id="pageInfo">—</span>
            <label class="page-size-picker">
                @T["Contacts.RowsPerPage"]
                <select id="pageSize">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </label>
        </div>
        <div class="pagination-controls">
            <button id="prevPage" class="btn-ghost" type="button">@T["Contacts.Pagination.Previous"]</button>
            <span id="pageLabel" class="pagination-page">—</span>
            <button id="nextPage" class="btn-ghost" type="button">@T["Contacts.Pagination.Next"]</button>
        </div>
    </footer>
</main>

@* ─── Contact Details modal (Lead card detail reference) ─── *@
<div class="modal-backdrop d-none" id="contactDetailsModal" onclick="if(event.target===this) closeContactDetailsModal()">
    <div class="modal-panel modal-panel-detail cd-shell">
        <button class="cd-close" type="button" onclick="closeContactDetailsModal()" aria-label="@T["Action.Close"]">✕</button>

        <div class="cd-body">
            <div class="cd-loading" id="cdLoading">@T["Action.Loading"]</div>

            <div class="cd-content d-none" id="cdContent">

                @* ── HERO ROW ─────────────────────────────────────────── *@
                <header class="cd-hero">
                    <div class="cd-hero-avatar-wrap">
                        <div class="cd-avatar" id="cdAvatar">?</div>
                    </div>

                    <div class="cd-hero-meta">
                        <div class="cd-hero-name-row">
                            <h2 class="cd-name" id="cdName">—</h2>
                            <span class="cd-pill" id="cdLifecycle"><span class="badge-dot"></span>—</span>
                        </div>
                        <div class="cd-company" id="cdChannel">—</div>
                        <div class="cd-hero-channels" id="cdChannelChips"></div>
                    </div>

                    <div class="cd-hero-stage">
                        <span class="cd-hero-label">@T["Contacts.Column.Lifecycle"]</span>
                        <div class="cd-hero-stage-display" id="cdHeroStageDisplay" title="@T["Contacts.Column.Lifecycle"]">
                            <span id="cdHeroStageText">—</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                        </div>
                    </div>

                    <div class="cd-hero-deal">
                        <span class="cd-hero-label">@T["Contacts.TotalMessages"]</span>
                        <div class="cd-hero-deal-value" id="cdHeroMsgValue">0</div>
                        <div class="cd-hero-deal-sub">@T["Contacts.FirstContact"]: <span id="cdHeroCreated">—</span></div>
                    </div>

                    <div class="cd-hero-actions">
                        <a href="#" class="cd-hero-btn cd-hero-btn-primary" id="cdOpenChat">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            <span>@T["Contacts.OpenConversation"]</span>
                        </a>
                        <div class="cd-kebab-wrap">
                            <button type="button" class="cd-hero-btn cd-hero-kebab" id="cdKebabBtn" aria-haspopup="menu" aria-label="@T["Roles.Action.ActionsAria"]" title="@T["Roles.Action.ActionsAria"]">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
                            </button>
                            <div class="cd-kebab-menu d-none" id="cdKebabMenu" role="menu">
                                <button type="button" class="cd-kebab-item" id="cdKebabBlock">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                    <span id="cdKebabBlockLabel">@T["Contacts.Confirm.Block.Action"]</span>
                                </button>
                                <button type="button" class="cd-kebab-item cd-kebab-item-danger" id="cdKebabDelete">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    <span>@T["Contacts.Confirm.Delete.Action"]</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </header>

                @* ── TAB BAR — Overview is the live tab; the others are visual
                   placeholders to mirror the reference. *@
                <nav class="cd-tabs" aria-label="@T["Contacts.Modal.Title"]">
                    <button type="button" class="cd-tab is-active" data-cd-tab="overview">@T["Dashboard.Pipeline.Title"]</button>
                    <button type="button" class="cd-tab" data-cd-tab="conversations" id="cdTabConversations">@T["Inbox.Title"]</button>
                    <button type="button" class="cd-tab" data-cd-tab="activity">@T["Dashboard.Activity.Title"]</button>
                </nav>

                @* ── BODY 4-COLUMN GRID (collapses on smaller screens). *@
                <div class="cd-grid-cols">

                    @* LEFT — Contact Info ─────────────────────────────── *@
                    <section class="cd-card cd-card-info">
                        <header class="cd-card-head">
                            <h3>@T["Contacts.Modal.Title"]</h3>
                        </header>
                        <ul class="cd-info-list">
                            <li class="cd-info-row">
                                <span class="cd-info-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.1 9.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg></span>
                                <span class="cd-info-val" id="cdPhone">—</span>
                            </li>
                            <li class="cd-info-row">
                                <span class="cd-info-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                                <span class="cd-info-val" id="cdCountry">—</span>
                            </li>
                            <li class="cd-info-row">
                                <span class="cd-info-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg></span>
                                <span class="cd-info-val" id="cdLanguage">—</span>
                            </li>
                            <li class="cd-info-row">
                                <span class="cd-info-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>
                                <span class="cd-info-val" id="cdAssigned">@T["Inbox.Unassigned"]</span>
                            </li>
                        </ul>
                    </section>

                    @* MIDDLE — Deal Information (stages stepper + meta + tags) *@
                    <section class="cd-card cd-card-deal">
                        <header class="cd-card-head">
                            <h3>@T["Contacts.Column.Lifecycle"]</h3>
                        </header>

                        <div class="cd-stages" id="cdStages" aria-label="@T["Contacts.Column.Lifecycle"]">
                            <span class="cd-stage" data-stage="0">@T["Lifecycle.NewClient"]</span>
                            <span class="cd-stage" data-stage="1">@T["Lifecycle.NotResponding"]</span>
                            <span class="cd-stage" data-stage="2">@T["Lifecycle.Interested"]</span>
                            <span class="cd-stage" data-stage="3">@T["Lifecycle.Thinking"]</span>
                            <span class="cd-stage" data-stage="4">@T["Lifecycle.WantsAMeeting"]</span>
                            <span class="cd-stage" data-stage="5">@T["Lifecycle.WaitingForMeeting"]</span>
                            <span class="cd-stage" data-stage="6">@T["Lifecycle.Discussed"]</span>
                            <span class="cd-stage" data-stage="7">@T["Lifecycle.PotentialClient"]</span>
                            <span class="cd-stage" data-stage="8">@T["Lifecycle.WillMakePayment"]</span>
                            <span class="cd-stage" data-stage="9">@T["Lifecycle.WaitingForContract"]</span>
                            <span class="cd-stage" data-stage="10">@T["Lifecycle.OurClient"]</span>
                        </div>

                        <div class="cd-deal-meta">
                            <div>
                                <div class="cd-deal-meta-label">@T["Contacts.Column.Status"]</div>
                                <div class="cd-deal-meta-val" id="cdStatus"><span class="badge-btn status-badge status-open"><span class="status-dot-inline"></span>@T["Inbox.Open"]</span></div>
                            </div>
                            <div>
                                <div class="cd-deal-meta-label">@T["Contacts.Blocked"]</div>
                                <div class="cd-deal-meta-val" id="cdBlocked">@T["Contacts.NotBlocked"]</div>
                            </div>
                        </div>

                        <div class="cd-tags-row">
                            <span class="cd-tags-label">Tags</span>
                            <div class="cd-tags" id="cdTags"></div>
                        </div>
                    </section>

                    @* RIGHT — Engagement summary + Add note quick-form *@
                    <section class="cd-card cd-card-insights">
                        <header class="cd-card-head">
                            <h3>Engagement</h3>
                        </header>
                        <ul class="cd-insights-list">
                            <li>
                                <span class="cd-insights-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 14 9l7 2-7 2-2 7-2-7-7-2 7-2 2-7z"/></svg></span>
                                <div class="cd-insights-body">
                                    <span class="cd-insights-label">@T["Contacts.TotalMessages"]</span>
                                    <strong id="cdMsgCount">0</strong>
                                </div>
                            </li>
                            <li>
                                <span class="cd-insights-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
                                <div class="cd-insights-body">
                                    <span class="cd-insights-label">@T["Contacts.InternalNotes"]</span>
                                    <strong id="cdNoteCount">0</strong>
                                </div>
                            </li>
                            <li>
                                <span class="cd-insights-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
                                <div class="cd-insights-body">
                                    <span class="cd-insights-label">@T["Contacts.FirstContact"]</span>
                                    <strong id="cdCreated">—</strong>
                                </div>
                            </li>
                        </ul>

                        <form class="cd-note-form" id="cdNoteForm">
                            <label class="cd-note-form-label" for="cdNoteInput">@T["Compose.Note"]</label>
                            <textarea id="cdNoteInput" class="cd-note-input" rows="2" placeholder="@T["TemplatePicker.SearchPlaceholder"]" maxlength="2000"></textarea>
                            <div class="cd-note-form-foot">
                                <span class="cd-note-feedback" id="cdNoteFeedback"></span>
                                <button type="submit" class="cd-note-submit" id="cdNoteSubmit">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    <span>@T["Compose.Note"]</span>
                                </button>
                            </div>
                        </form>
                    </section>

                    @* FAR-RIGHT — Activity timeline (seeded from existing data) *@
                    <section class="cd-card cd-card-activity">
                        <header class="cd-card-head">
                            <h3>@T["Dashboard.Activity.Title"]</h3>
                        </header>
                        <ol class="cd-timeline" id="cdTimeline"></ol>
                    </section>

                </div>

                @* ── INTERNAL FILES — private, team-only attachments. Never shown to or sent
                   to the contact; managed through authorized endpoints only. *@
                <section class="cd-card cd-card-files" id="cdFilesCard">
                    <header class="cd-card-head cd-files-head">
                        <h3>
                            @T["ContactFiles.Title"]
                            <span class="cd-files-private" title="@T["ContactFiles.PrivateHint"]">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            @T["ContactFiles.PrivateBadge"]
                            </span>
                        </h3>
                        @* Upload control — hidden on read-only roles via data-can-edit gate in JS. *@
                        <div class="cd-files-upload" id="cdFilesUpload">
                            <input type="file" id="cdFilesInput" multiple class="d-none" />
                            <button type="button" class="btn-primary-soft has-icon" id="cdFilesUploadBtn">
                                @await Html.PartialAsync("_Icon", new IconModel("upload", size: 14))
                                <span>@T["ContactFiles.Upload"]</span>
                            </button>
                        </div>
                    </header>

                    <p class="cd-files-note">@T["ContactFiles.Note"]</p>

                    <div class="cd-files-list" id="cdFilesList" aria-live="polite"></div>
                    <div class="cd-files-empty d-none" id="cdFilesEmpty">@T["ContactFiles.Empty"]</div>
                </section>

            </div>
        </div>
    </div>
</div>

@* ─── Confirmation modals ─── *@
<div class="modal-backdrop d-none" id="confirmModal" onclick="if(event.target===this) closeConfirmModal()">
    <div class="modal-panel modal-panel-small">
        <div class="modal-header">
            <h3 id="confirmTitle">@T["Common.Confirm.Title"]</h3>
            <button class="modal-close" type="button" onclick="closeConfirmModal()">✕</button>
        </div>
        <div class="modal-body">
            <p id="confirmBody" style="margin:0 0 8px;font-size:13.5px;color:#374151;"></p>
            <ul id="confirmList" class="disconnect-bullets"></ul>
        </div>
        <div class="modal-actions">
            <button class="btn-ghost" type="button" onclick="closeConfirmModal()">@T["Action.Cancel"]</button>
            <button class="btn-ghost btn-danger" type="button" id="confirmAction">@T["Common.Confirm.Action"]</button>
        </div>
    </div>
</div>

@* ─── Import Contacts modal ─── *@
<div class="modal-backdrop d-none" id="importModal" onclick="if(event.target===this) closeImportModal()">
    <div class="modal-panel import-modal">
        <div class="modal-header">
            <h3 id="importModalTitle">@T["Contacts.Import.Title"]</h3>
            <button class="modal-close" type="button" onclick="closeImportModal()" aria-label="@T["Action.Close"]">✕</button>
        </div>

        @* Step 1 — choose action *@
        <div class="modal-body import-step" id="importStepChoose">
            <p class="import-intro">@T["Contacts.Import.Intro"]</p>

            <div class="import-actions">
                <a class="import-action-card" id="importDownloadTemplate" href="/api/contacts/import/template" download>
                    @await Html.PartialAsync("_Icon", new IconModel("download", size: 18))
                    <div class="import-action-text">
                        <strong>@T["Contacts.Import.DownloadTemplate"]</strong>
                        <span>@T["Contacts.Import.DownloadTemplateHint"]</span>
                    </div>
                </a>

                <label class="import-dropzone" id="importDropzone">
                    @await Html.PartialAsync("_Icon", new IconModel("upload", size: 18))
                    <div class="import-action-text">
                        <strong>@T["Contacts.Import.UploadFile"]</strong>
                        <span id="importDropzoneHint">@T["Contacts.Import.UploadHint"]</span>
                    </div>
                    <input type="file" id="importFileInput" accept=".xlsx,.xls" hidden />
                </label>
            </div>

            <p class="import-required-hint">@T["Contacts.Import.RequiredHint"]</p>
        </div>

        @* Step 2 — preview *@
        <div class="modal-body import-step d-none" id="importStepPreview">
            <div class="import-summary" id="importSummary"></div>

            <div class="import-duplicates d-none" id="importDuplicatesSection">
                <strong>@T["Contacts.Import.DuplicatesFound"]</strong>
                <p class="import-duplicates-hint" id="importDuplicatesHint"></p>
                <div class="import-duplicate-radios">
                    <label><input type="radio" name="dupStrategy" value="Skip" checked /> @T["Contacts.Import.DupSkip"]</label>
                    <label><input type="radio" name="dupStrategy" value="Update" /> @T["Contacts.Import.DupUpdate"]</label>
                    <label><input type="radio" name="dupStrategy" value="ImportAnyway" /> @T["Contacts.Import.DupImportAnyway"]</label>
                </div>
            </div>

            <div class="import-table-wrap">
                <table class="import-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@T["Contacts.Import.Col.Name"]</th>
                            <th>@T["Contacts.Import.Col.Phone"]</th>
                            <th>@T["Contacts.Import.Col.Email"]</th>
                            <th>@T["Contacts.Import.Col.Company"]</th>
                            <th>@T["Contacts.Import.Col.Status"]</th>
                        </tr>
                    </thead>
                    <tbody id="importPreviewBody"></tbody>
                </table>
            </div>

            <details class="import-errors d-none" id="importErrorsSection">
                <summary id="importErrorsSummary"></summary>
                <ul id="importErrorsList"></ul>
                <button class="btn-ghost" type="button" id="importDownloadErrorsBtn">
                    @await Html.PartialAsync("_Icon", new IconModel("download", size: 14))
                    <span>@T["Contacts.Import.DownloadErrors"]</span>
                </button>
            </details>
        </div>

        @* Step 3 — final summary *@
        <div class="modal-body import-step d-none" id="importStepResult">
            <div class="import-result" id="importResultContent"></div>
            <details class="import-errors d-none" id="importResultErrors">
                <summary id="importResultErrorsSummary"></summary>
                <ul id="importResultErrorsList"></ul>
                <button class="btn-ghost" type="button" id="importResultDownloadErrorsBtn">
                    @await Html.PartialAsync("_Icon", new IconModel("download", size: 14))
                    <span>@T["Contacts.Import.DownloadErrors"]</span>
                </button>
            </details>
        </div>

        <div class="modal-actions">
            <button class="btn-ghost" type="button" id="importBackBtn">@T["Action.Cancel"]</button>
            <button class="btn-primary-soft" type="button" id="importConfirmBtn" disabled>
                <span id="importConfirmLabel">@T["Contacts.Import.Confirm"]</span>
                <span class="btn-spinner d-none" aria-hidden="true"></span>
            </button>
        </div>
    </div>
</div>

<div class="toast-stack" id="toastStack"></div>
@Html.AntiForgeryToken()

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    window.__TEAM__ = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(team.Select(u => new { id = u.Id, name = u.Name })));
    window.__CURRENT_USER_ID__ = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentUserId));
</script>
<script src="~/js/contacts.js" asp-append-version="true"></script>
<script src="~/js/contacts-import.js" asp-append-version="true"></script>

@* Per-contact AI agent picker popover (anchored to the clicked row's agent chip). *@
@Html.AntiForgeryToken()
<div class="ag-picker-popover d-none" id="contactAgentPopover" role="menu">
    <ul class="ag-picker-list" id="contactAgentPickerList"></ul>
    <div class="ag-picker-empty d-none" id="contactAgentPickerEmpty">@T["Agents.Picker.Empty"]</div>
</div>
<script src="~/js/contacts-agent-picker.js" asp-append-version="true"></script>

</body>
</html>
