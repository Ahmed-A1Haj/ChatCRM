@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer T
@{
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    ViewData["Title"] = T["Landing.Meta.Title"].Value;

    var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    var landingLanguages = new (string Code, string Native, string Flag)[]
    {
        ("en", "English",   "🇬🇧"),
        ("ru", "Русский",   "🇷🇺"),
        ("ro", "Română",    "🇷🇴"),
        ("tr", "Türkçe",    "🇹🇷")
    };
    var activeLang = landingLanguages.FirstOrDefault(l => l.Code == currentLang);
    if (activeLang.Code is null) activeLang = landingLanguages[0];
    var landingReturnUrl = Context.Request.Path + Context.Request.QueryString;
}

@* ───────────────────────── NAV ───────────────────────── *@
<header class="pz-nav" id="pzNav">
    <div class="pz-container pz-nav__inner">
        <a href="/" class="pz-brand" aria-label="ChatCRM home">
            <svg class="pz-brand__leaf" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 2C7 6 4 10 4 14a8 8 0 0 0 16 0c0-4-3-8-8-12zm0 18c-2.6 0-4.5-1.6-5.4-3.8 1.2.5 2.6.8 4 .8 3.1 0 5.4-1.6 6.4-3.5C16.5 17 14.5 20 12 20z"/>
            </svg>
            ChatCRM
        </a>

        <nav class="pz-nav__links" aria-label="Primary">
            <a href="#omnichannel">@T["Landing.Nav.Product"]</a>
            <a href="#ai">@T["Landing.Nav.AI"]</a>
            <a href="#channels">@T["Landing.Nav.Channels"]</a>
            <a href="#pricing">@T["Landing.Nav.Pricing"]</a>
            <a href="#use-cases">@T["Landing.Nav.Resources"]</a>
        </nav>

        <div class="pz-nav__cta">
            <div class="pz-lang pz-lang--nav" data-pz-lang>
                <button type="button" class="pz-lang__btn" data-pz-lang-toggle aria-haspopup="listbox" aria-expanded="false" aria-label="@T["Language.Switch"]">
                    <span class="pz-lang__flag" aria-hidden="true">@activeLang.Flag</span>
                    <span class="pz-lang__code">@activeLang.Code.ToUpperInvariant()</span>
                    <svg class="pz-lang__chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>
                <div class="pz-lang__menu" data-pz-lang-menu role="listbox" hidden>
                    @foreach (var lang in landingLanguages)
                    {
                        <form method="post" asp-controller="Language" asp-action="Set" class="pz-lang__form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="culture" value="@lang.Code" />
                            <input type="hidden" name="returnUrl" value="@landingReturnUrl" />
                            <button type="submit" class="pz-lang__item @(lang.Code == currentLang ? "is-active" : "")" role="option" aria-selected="@(lang.Code == currentLang ? "true" : "false")">
                                <span class="pz-lang__flag" aria-hidden="true">@lang.Flag</span>
                                <span class="pz-lang__name">@lang.Native</span>
                                @if (lang.Code == currentLang)
                                {
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                }
                            </button>
                        </form>
                    }
                </div>
            </div>
            <a class="pz-btn pz-btn--ghost" href="/Account/Login">@T["Landing.Nav.Login"]</a>
            <a class="pz-btn pz-btn--primary" href="/Account/Register">@T["Landing.Nav.GetStarted"]</a>
            <button class="pz-nav__toggle" id="pzNavToggle" type="button" aria-expanded="false" aria-controls="pzNavMenu" aria-label="@T["Landing.Nav.OpenMenu"]">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>
        </div>
    </div>

    <div id="pzNavMenu" class="pz-nav__menu" role="menu">
        <a href="#omnichannel">@T["Landing.Nav.Product"]</a>
        <a href="#ai">@T["Landing.Nav.AI"]</a>
        <a href="#channels">@T["Landing.Nav.Channels"]</a>
        <a href="#pricing">@T["Landing.Nav.Pricing"]</a>
        <a href="#use-cases">@T["Landing.Nav.Resources"]</a>
        <a href="/Account/Login">@T["Landing.Nav.Login"]</a>
        <a class="pz-btn pz-btn--primary" href="/Account/Register">@T["Landing.Nav.GetStarted"]</a>
    </div>
</header>

@* ───────────────────────── HERO ───────────────────────── *@
<section class="pz-hero">
