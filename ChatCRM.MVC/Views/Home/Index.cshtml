@* ──────────────────── PIPELINE / WORKFLOW ──────────────────── *@
<section class="pz-section" id="pipeline">
    <div class="pz-container">
        <div class="pz-section__head pz-section__head--left pz-reveal">
            <h2>Watch every lead move forward — <em>automatically.</em></h2>
        </div>

        <div class="pz-pipeline">
            @* Decorative marble orb floating between kanban and workflow *@
            <div class="pz-pipeline__orb" aria-hidden="true">
                <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <defs>
                        <radialGradient id="pzOrbBase2" cx="35%" cy="28%" r="80%">
                            <stop offset="0%"  stop-color="#ffffff"/>
                            <stop offset="18%" stop-color="#f6efd9"/>
                            <stop offset="50%" stop-color="#d6dec4"/>
                            <stop offset="80%" stop-color="#7e9576"/>
                            <stop offset="100%" stop-color="#3a4f36"/>
                        </radialGradient>
                        <radialGradient id="pzOrbHighlight2" cx="32%" cy="22%" r="22%">
                            <stop offset="0%"  stop-color="#ffffff" stop-opacity="0.95"/>
                            <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
                        </radialGradient>
                    </defs>
                    <circle cx="50" cy="50" r="46" fill="url(#pzOrbBase2)"/>
                    <ellipse cx="38" cy="28" rx="16" ry="9" fill="url(#pzOrbHighlight2)"/>
                </svg>
            </div>

            <div class="pz-kanban pz-reveal">
                @{
                    var stages = new (string Name, string Stage, int Count, (string Initials, string Name, string Amt)[] Cards)[] {
                        ("New Lead", "new", 2, new[] { ("AJ", "Alex Johnson", "$2,400"), ("MR", "Maria Rodriguez", "$1,800") }),
                        ("Contacted", "contact", 2, new[] { ("LC", "Liam Chen", "$3,200"), ("SP", "Sara Patel", "$2,750") }),
                        ("Qualified", "qualify", 1, new[] { ("EM", "Emma Müller", "$4,100") }),
                        ("Negotiation", "negotiate", 1, new[] { ("DK", "David Kim", "$6,800") }),
                        ("Won", "won", 2, new[] { ("SL", "Sarah Lee", "$5,200"), ("TN", "Tom Nguyen", "$3,900") })
                    };
                }
                @foreach (var s in stages)
                {
                    <div class="pz-kanban__col" data-stage="@s.Stage">
                        <div class="pz-kanban__head">
                            <span>@s.Name</span>
                            <span class="pz-kanban__count">@s.Count</span>
                        </div>
                        @foreach (var c in s.Cards)
                        {
                            <div class="pz-kanban__card">
                                <span class="pz-avatar-sm">@c.Initials</span>
                                <div class="pz-kanban__info">
                                    <span class="pz-kanban__name">@c.Name</span>
                                    <span class="pz-kanban__amt">@c.Amt</span>
                                </div>
                                <span class="pz-kanban__dot"></span>
                            </div>
                        }
                    </div>
                }
            </div>

            <aside class="pz-workflow pz-reveal" aria-label="Automation workflow">
                <div class="pz-workflow__title">Workflow Trigger</div>
                <div class="pz-flow-node">
                    <span class="pz-flow-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7v8l10-12h-7V2z"/></svg>
                    </span>
                    <span><strong>Trigger:</strong> New WhatsApp message</span>
                </div>
                <span class="pz-flow-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="6 13 12 19 18 13"/></svg>
                </span>
                <div class="pz-flow-node">
                    <span class="pz-flow-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M5 12a7 7 0 0 1 14 0"/></svg>
                    </span>
                    <span><strong>AI:</strong> Qualify intent</span>
                </div>
                <span class="pz-flow-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="6 13 12 19 18 13"/></svg>
                </span>
                <div class="pz-flow-node">
                    <span class="pz-flow-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3h18v18H3z"/><path d="M8 8h8M8 12h6M8 16h4"/></svg>
                    </span>
                    <span><strong>Action:</strong> Assign to Sara</span>
                </div>
                <span class="pz-flow-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="6 13 12 19 18 13"/></svg>
                </span>
                <div class="pz-flow-node">
                    <span class="pz-flow-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <span><strong>Action:</strong> Next escalation</span>
                </div>
            </aside>
        </div>
    </div>
</section>

@* ──────────────────── USE CASES ──────────────────── *@
<section class="pz-section pz-section--tinted" id="use-cases">
    <div class="pz-container">
        <div class="pz-section__head pz-reveal">
            <h2>Built for teams that <em>live</em> in messengers.</h2>
            <p>Discover how our platform empowers communication-driven industries.</p>
        </div>

        <div class="pz-use__grid">
            @{
                var useCases = new (string Title, string Desc, string Svg)[] {
                    ("E-commerce", "Streamline customer support and track orders instantly.",
                     "<path d='M3 6h2l2.4 11.4a1.5 1.5 0 0 0 1.5 1.1h8.4a1.5 1.5 0 0 0 1.5-1.1L21 9H6'/><circle cx='9' cy='21' r='1.4'/><circle cx='17' cy='21' r='1.4'/>"),
                    ("Real Estate", "Generate viewings and finalize deals in real time.",
                     "<path d='M3 11 12 3l9 8v9a1.5 1.5 0 0 1-1.5 1.5H4.5A1.5 1.5 0 0 1 3 20v-9z'/><path d='M9 21V13h6v8'/>"),
                    ("Healthcare", "Manage appointments and securely communicate with patients.",
                     "<path d='M12 21s-7-4.5-7-11a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 6.5-7 11-7 11z'/><path d='M9 11h2v-2h2v2h2v2h-2v2h-2v-2H9z' fill='currentColor' stroke='none'/>"),
                    ("Education", "Connect students, faculty and administrators seamlessly.",
                     "<path d='M2 9l10-5 10 5-10 5L2 9z'/><path d='M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5'/><path d='M22 9v6'/>"),
                    ("Marketing Agencies", "Collaborate on campaigns and update clients efficiently.",
                     "<path d='M3 11l18-7-3 18-6-9-9-2z'/><path d='M9 12l3 5'/>"),
                    ("Hospitality", "Handle bookings and enhance guest experience remotely.",
                     "<path d='M3 21V8l9-5 9 5v13'/><path d='M9 21V13h6v8'/><path d='M12 8v.01'/>")
                };
            }
            @foreach (var u in useCases)
