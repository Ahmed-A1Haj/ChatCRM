                        </div>
                        <div class="pz-inbox-row">
                            <span class="pz-inbox-row__icon" style="background:var(--c-whatsapp)">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11.9a8 8 0 0 1-12 6.9L4 20l1.3-3.8A8 8 0 1 1 20 11.9z"/></svg>
                            </span>
                            <div class="pz-inbox-row__main">
                                <div class="pz-inbox-row__top">
                                    <span class="pz-inbox-row__name">WhatsApp</span>
                                    <span class="pz-inbox-row__pill">WhatsApp</span>
                                </div>
