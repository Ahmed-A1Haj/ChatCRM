                            <span class="pz-inbox-row__avatar"></span>
                        </div>
                        <div class="pz-inbox-row">
                            <span class="pz-inbox-row__icon" style="background:linear-gradient(135deg,#feda77,#d6249f,#4f5bd5)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
                            </span>
                            <div class="pz-inbox-row__main">
                                <div class="pz-inbox-row__top">
                                    <span class="pz-inbox-row__name">Instagram</span>
                                    <span class="pz-inbox-row__pill">Instagram</span>
                                </div>
                                <span class="pz-inbox-row__msg">Hey — saw your latest message</span>
                            </div>
                            <span class="pz-inbox-row__time">9:37 AM</span>
                            <span class="pz-inbox-row__avatar" style="background:linear-gradient(135deg,#f0b9d1,#d6249f)"></span>
                        </div>
                        <div class="pz-inbox-row">
                            <span class="pz-inbox-row__icon" style="background:var(--c-messenger)">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.2 2 11.3c0 2.9 1.4 5.5 3.6 7.2v3.5l3.3-1.8c.9.3 1.9.4 3.1.4 5.5 0 10-4.2 10-9.3S17.5 2 12 2z"/></svg>
                            </span>
                            <div class="pz-inbox-row__main">
                                <div class="pz-inbox-row__top">
                                    <span class="pz-inbox-row__name">Facebook Messenger</span>
                                </div>
                                <span class="pz-inbox-row__msg">Thank you for your message — moving to your...</span>
                            </div>
                            <span class="pz-inbox-row__time">8:33 AM</span>
                            <span class="pz-inbox-row__avatar" style="background:linear-gradient(135deg,#cfe1f7,#0084ff)"></span>
                        </div>
                        <div class="pz-inbox-row">
                            <span class="pz-inbox-row__icon" style="background:var(--c-telegram)">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.5 4.2 18.7 19c-.2 1-.8 1.2-1.6.8l-4.5-3.3-2.2 2.1.3-4.5 8.2-7.4-10.4 6.4-4.4-1.4 17.2-6.6c.8-.3 1.5.2 1.2 1.6z"/></svg>
