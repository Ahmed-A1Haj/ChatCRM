@* ──────────────────── HOW IT WORKS ──────────────────── *@
<section class="pz-section" id="how-it-works">
    <div class="pz-container">
        <div class="pz-section__head pz-reveal">
            <h2>See how a lead becomes a customer <em>in seconds.</em></h2>
        </div>

        <div class="pz-how__steps">
            <article class="pz-step pz-reveal">
                <div class="pz-step__text">
                    <span class="pz-step__num">1</span>
                    <h3 class="pz-step__title">Customer messages you on <strong>WhatsApp</strong></h3>
                    <p class="pz-step__desc">Whether it's a question, a quote, or a booking request — it lands in your unified inbox in real time.</p>
                </div>
                <div class="pz-step__visual">
                    <div class="pz-msg-card">
                        <span class="pz-avatar">EM</span>
                        <div class="pz-msg-body">
                            Emma Müller
                            <small>"Hi — do you have a 2 BR available next week?"</small>
                        </div>
                    </div>
                    <span class="pz-msg-pill">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                        Message accepted
