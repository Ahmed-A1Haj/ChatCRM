@{
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    ViewData["Title"] = "ChatCRM — Every conversation. Every channel. One intelligent CRM.";
}

@* ───────────────────────── NAV ───────────────────────── *@
<header class="pz-nav" id="pzNav">
    <div class="pz-container pz-nav__inner">
        <a href="/" class="pz-brand" aria-label="ChatCRM home">
            <svg class="pz-brand__leaf" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 2C7 6 4 10 4 14a8 8 0 0 0 16 0c0-4-3-8-8-12zm0 18c-2.6 0-4.5-1.6-5.4-3.8 1.2.5 2.6.8 4 .8 3.1 0 5.4-1.6 6.4-3.5C16.5 17 14.5 20 12 20z"/>
            </svg>
            ChatCRM
        </a>

        <nav class="pz-nav__links" aria-label="Primary">
            <a href="#omnichannel">Product</a>
            <a href="#ai">AI</a>
            <a href="#channels">Channels</a>
            <a href="#pricing">Pricing</a>
            <a href="#use-cases">Resources</a>
        </nav>

        <div class="pz-nav__cta">
            <a class="pz-btn pz-btn--ghost" href="/Account/Login">Login</a>
            <a class="pz-btn pz-btn--primary" href="/Account/Register">Get Started</a>
            <button class="pz-nav__toggle" id="pzNavToggle" type="button" aria-expanded="false" aria-controls="pzNavMenu" aria-label="Open menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>
        </div>
    </div>

    <div id="pzNavMenu" class="pz-nav__menu" role="menu">
        <a href="#omnichannel">Product</a>
        <a href="#ai">AI</a>
        <a href="#channels">Channels</a>
        <a href="#pricing">Pricing</a>
        <a href="#use-cases">Resources</a>
        <a href="/Account/Login">Login</a>
        <a class="pz-btn pz-btn--primary" href="/Account/Register">Get Started</a>
    </div>
</header>

@* ───────────────────────── HERO ───────────────────────── *@
<section class="pz-hero">
    <div class="pz-container pz-hero__grid">
        <div class="pz-hero__copy pz-reveal">
            <h1>Every conversation.<br />Every channel.<br />One intelligent CRM.</h1>
            <p class="pz-hero__sub">
                Everything Kommo does. All of respond.io's AI.<br />
                Beautifully unified.
            </p>

            <div class="pz-hero__cta">
                <a class="pz-btn pz-btn--primary pz-btn--lg" href="/Account/Register">Start free trial</a>
                <a class="pz-btn pz-btn--outline pz-btn--lg" href="#how-it-works">Watch 2-min demo</a>
            </div>

            <div class="pz-trust">
                <span class="pz-trust__label">Trusted by teams at</span>
                <div class="pz-trust__logos">
                    @* Mercury *@
                    <span class="pz-trust__logo" aria-label="Mercury">
                        <svg viewBox="0 0 120 28" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true">
                            <circle cx="14" cy="14" r="9" fill="none" stroke="currentColor" stroke-width="2"/>
                            <circle cx="14" cy="14" r="3.5"/>
                            <text x="32" y="19" font-family="Inter,system-ui,sans-serif" font-size="14" font-weight="600" letter-spacing="-0.02em">Mercury</text>
                        </svg>
                    </span>
                    @* ramp *@
                    <span class="pz-trust__logo" aria-label="Ramp">
                        <svg viewBox="0 0 80 28" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true">
                            <text x="0" y="20" font-family="Inter,system-ui,sans-serif" font-size="18" font-weight="700" letter-spacing="-0.03em">ramp</text>
                        </svg>
                    </span>
                    @* airbnb *@
                    <span class="pz-trust__logo" aria-label="Airbnb">
                        <svg viewBox="0 0 110 28" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true">
                            <path d="M14 4c-2.4 0-4.4 1.6-5.2 3.9-1.4 4-4.6 11-4.6 13.4 0 3.1 2.4 4.7 4.7 4.7 1.5 0 3.1-.8 5.1-3 2 2.2 3.6 3 5.1 3 2.3 0 4.7-1.6 4.7-4.7 0-2.4-3.2-9.4-4.6-13.4C18.4 5.6 16.4 4 14 4zm0 2.2c1.3 0 2.4.9 2.9 2.3 1.3 3.8 4.3 10.5 4.3 12.7 0 1.8-1.2 2.8-2.7 2.8-1 0-2.1-.5-3.7-2.5 1.4-2 2.7-4.5 2.7-6.5 0-2.3-1.4-3.6-3.5-3.6s-3.5 1.3-3.5 3.6c0 2 1.3 4.5 2.7 6.5-1.6 2-2.7 2.5-3.7 2.5-1.5 0-2.7-1-2.7-2.8 0-2.2 3-8.9 4.3-12.7.5-1.4 1.6-2.3 2.9-2.3zm0 6.5c.9 0 1.5.6 1.5 1.6 0 1.2-.8 2.9-1.5 4-.7-1.1-1.5-2.8-1.5-4 0-1 .6-1.6 1.5-1.6z"/>
                            <text x="32" y="20" font-family="Inter,system-ui,sans-serif" font-size="16" font-weight="700" letter-spacing="-0.04em">airbnb</text>
                        </svg>
                    </span>
                    @* Linear *@
                    <span class="pz-trust__logo" aria-label="Linear">
                        <svg viewBox="0 0 110 28" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true">
                            <path d="M4 14a10 10 0 0 1 10-10 10 10 0 0 1 10 10 10 10 0 0 1-10 10A10 10 0 0 1 4 14zm2.3-2.4 12.1 12.1c-1.3.6-2.8 1-4.4 1L4.2 14.5c0-1 .4-2 .8-2.9zm.7-2.7 13.4 13.4c-.7.7-1.5 1.3-2.4 1.8L5.7 11c.4-.7.8-1.4 1.3-2.1zm2.2-2.3L21 18.5c-.4.7-.9 1.4-1.5 2L8.2 8.9c.4-.6.8-1.1 1.3-1.6.3-.2.4-.3.7-.7zm3.4-1.8a10 10 0 0 1 9.9 9.9z"/>
                            <text x="30" y="20" font-family="Inter,system-ui,sans-serif" font-size="16" font-weight="600" letter-spacing="-0.02em">Linear</text>
                        </svg>
                    </span>
                    @* stripe *@
                    <span class="pz-trust__logo" aria-label="Stripe">
                        <svg viewBox="0 0 80 28" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true">
                            <text x="0" y="20" font-family="Inter,system-ui,sans-serif" font-size="18" font-weight="700" font-style="italic" letter-spacing="-0.03em">stripe</text>
                        </svg>
                    </span>
                </div>
            </div>
        </div>

        <div class="pz-hero__visual pz-reveal" aria-hidden="true">
            <div class="pz-tablet">
                <div class="pz-tablet__topbar">
                    <span class="pz-tablet__title">Inbox</span>
                    <span class="pz-tablet__search">
