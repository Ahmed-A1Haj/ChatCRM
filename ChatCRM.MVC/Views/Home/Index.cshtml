                    <div class="pz-bubble pz-bubble--ai">@T["Landing.AI.Card1.Bubble2"]</div>
                    <div class="pz-bubble pz-bubble--in">@T["Landing.AI.Card1.Bubble3"]</div>
                    <div class="pz-bubble pz-bubble--ai">@T["Landing.AI.Card1.Bubble4"]</div>
                </div>
                <p class="pz-card__desc">@T["Landing.AI.Card1.Desc"]</p>
            </article>

            <article class="pz-card pz-reveal">
                <span class="pz-card__icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16v10H8l-4 4V5z"/><path d="M8 10h8M8 13h5"/></svg>
