                    </span>
                    <span class="pz-tablet__topbar-right">
                        <span class="pz-tablet__bell">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 7 3 9H3c0-2 3-2 3-9z"/></svg>
                        </span>
                        <span class="pz-tablet__me"></span>
                    </span>
                </div>
                <div class="pz-tablet__body">
                    <div class="pz-tablet__inbox">
                        <div class="pz-tablet__tabs">
                            <span class="pz-tablet__tab is-active">@T["Landing.Tablet.Tab.AllLive"]</span>
                            <span class="pz-tablet__tab">@T["Landing.Tablet.Tab.Threads"]</span>
                            <span class="pz-tablet__tab">@T["Landing.Tablet.Tab.Channels"]</span>
                            <span class="pz-tablet__tabs-spacer"></span>
                            <span class="pz-tablet__filter">@T["Landing.Tablet.Filters"]</span>
