                            </div>
                            <div class="pz-contact__insight">
                                <strong>
                                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 14 9l7 2-7 2-2 7-2-7-7-2 7-2 2-7z"/></svg>
                                    AI-driven insights
                                </strong>
                                Warmest ever and looms hatches to describe our stories.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <span class="pz-hero__spark pz-hero__spark--tl" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 14 9l7 2-7 2-2 7-2-7-7-2 7-2 2-7z"/></svg>
            </span>
            <span class="pz-hero__spark pz-hero__spark--tr" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 14 9l7 2-7 2-2 7-2-7-7-2 7-2 2-7z"/></svg>
            </span>
            <span class="pz-hero__spark pz-hero__spark--bl pz-hero__spark--sm" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 14 9l7 2-7 2-2 7-2-7-7-2 7-2 2-7z"/></svg>
            </span>
            <span class="pz-hero__spark pz-hero__spark--br" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 14 9l7 2-7 2-2 7-2-7-7-2 7-2 2-7z"/></svg>
            </span>
        </div>
    </div>
</section>

@* ──────────────────── OMNICHANNEL VIS ──────────────────── *@
<section class="pz-section" id="omnichannel">
    <div class="pz-container">
        <div class="pz-section__head pz-reveal">
            <h2>One inbox. Every channel. <em>Zero chaos.</em></h2>
            <p>Your customers message wherever they want. You reply from one place.</p>
        </div>

        <div class="pz-omni__stage pz-reveal" aria-hidden="true">
            @* Subtle elegant orbits *@
            <svg class="pz-omni__svg" viewBox="0 0 1100 620" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <defs>
                    <radialGradient id="pzOmniGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%"  stop-color="#ffffff" stop-opacity="0.0"/>
                        <stop offset="55%" stop-color="#d8dec5" stop-opacity="0.30"/>
                        <stop offset="100%" stop-color="#aabba4" stop-opacity="0"/>
                    </radialGradient>
                    <linearGradient id="pzRibbon" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%"  stop-color="#b9c7af"/>
                        <stop offset="50%" stop-color="#8ea183"/>
                        <stop offset="100%" stop-color="#b9c7af"/>
                    </linearGradient>
                </defs>
                <circle cx="550" cy="320" r="280" fill="url(#pzOmniGlow)"/>

                <g fill="none" stroke="url(#pzRibbon)" stroke-width="1.2" stroke-linecap="round" opacity="0.40">
                    <ellipse cx="550" cy="320" rx="260" ry="160" transform="rotate(-15 550 320)"/>
                    <ellipse cx="550" cy="320" rx="240" ry="170" transform="rotate(20 550 320)"/>
                </g>
            </svg>

            @* Polished marble sphere — clean radial gradient, no yin-yang *@
            <div class="pz-omni__swirl-wrap">
                <svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true">
                    <defs>
                        <radialGradient id="pzOrbBase" cx="35%" cy="28%" r="80%">
                            <stop offset="0%"  stop-color="#ffffff"/>
                            <stop offset="18%" stop-color="#f6efd9"/>
                            <stop offset="50%" stop-color="#d6dec4"/>
                            <stop offset="80%" stop-color="#7e9576"/>
                            <stop offset="100%" stop-color="#3a4f36"/>
                        </radialGradient>
                        <radialGradient id="pzOrbHighlight" cx="32%" cy="22%" r="22%">
                            <stop offset="0%"  stop-color="#ffffff" stop-opacity="0.95"/>
                            <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
                        </radialGradient>
                        <radialGradient id="pzOrbBottomShade" cx="65%" cy="80%" r="40%">
                            <stop offset="0%"  stop-color="#2c3a26" stop-opacity="0.20"/>
                            <stop offset="100%" stop-color="#2c3a26" stop-opacity="0"/>
                        </radialGradient>
                    </defs>

                    <circle cx="50" cy="50" r="46" fill="url(#pzOrbBase)"/>
                    <circle cx="50" cy="50" r="46" fill="url(#pzOrbBottomShade)"/>
                    <ellipse cx="38" cy="28" rx="16" ry="9" fill="url(#pzOrbHighlight)"/>
                    <circle cx="50" cy="50" r="46" fill="none" stroke="#3a4a35" stroke-width="0.4" opacity="0.25"/>
                </svg>
            </div>

            @* Decorative chat bubble with realistic copy *@
            <div class="pz-omni__deco pz-omni__deco--chat">
                <span class="pz-omni__deco-avatar"></span>
                <span>Hi! Is the 2-bedroom in Lisbon<br />still available for July? Looking<br />to book a viewing this week.</span>
            </div>

            <div class="pz-omni__deco pz-omni__deco--contact">
                <span class="pz-omni__deco-avatar"></span>
                Emma Müller
            </div>

            <div class="pz-omni__deco pz-omni__deco--typing" aria-label="typing">
                <span></span><span></span><span></span>
            </div>

            <div class="pz-omni__deco pz-omni__deco--voice">
                <span class="pz-omni__voice-play">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7L8 5z"/></svg>
                </span>
                <span class="pz-omni__voice-wave">
                    <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                </span>
            </div>

            <div class="pz-omni__nodes-wrap">
                <div class="pz-omni__node pz-omni__node--wa">
                    <span class="pz-omni__chip" style="background:var(--c-whatsapp)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11.9a8 8 0 0 1-12 6.9L4 20l1.3-3.8A8 8 0 1 1 20 11.9z"/></svg>
                    </span>
                    WhatsApp
                </div>
                <div class="pz-omni__node pz-omni__node--ig">
                    <span class="pz-omni__chip" style="background:var(--c-instagram)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></svg>
                    </span>
                    Instagram
                </div>
                <div class="pz-omni__node pz-omni__node--fb">
                    <span class="pz-omni__chip" style="background:var(--c-messenger)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.2 2 11.3c0 2.9 1.4 5.5 3.6 7.2v3.5l3.3-1.8c.9.3 1.9.4 3.1.4 5.5 0 10-4.2 10-9.3S17.5 2 12 2z"/></svg>
                    </span>
                    Facebook Messenger
                </div>
                <div class="pz-omni__node pz-omni__node--tg">
                    <span class="pz-omni__chip" style="background:var(--c-telegram)">
