@* ──────────────────── AI CAPABILITIES ──────────────────── *@
<section class="pz-section pz-section--tinted" id="ai">
    <div class="pz-container">
        <div class="pz-section__head pz-reveal">
            <h2>@T["Landing.AI.H2.Part1"] <em>@T["Landing.AI.H2.Em"]</em></h2>
            <p>@T["Landing.AI.Sub"]</p>
        </div>

        <div class="pz-ai__grid">
            <article class="pz-card pz-reveal">
                <span class="pz-card__icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M9 10c.5-1 1.5-2 3-2s2.5 1 3 2-.5 2.5-2 3"/><circle cx="12" cy="17" r="0.8" fill="currentColor"/></svg>
