    </div>
</section>

@* ──────────────────── PIPELINE / WORKFLOW ──────────────────── *@
<section class="pz-section" id="pipeline">
    <div class="pz-container">
        <div class="pz-section__head pz-section__head--left pz-reveal">
            <h2>@T["Landing.Pipeline.H2.Part1"] <em>@T["Landing.Pipeline.H2.Em"]</em></h2>
        </div>

        <div class="pz-pipeline">
            @* Decorative marble orb floating between kanban and workflow *@
            <div class="pz-pipeline__orb" aria-hidden="true">
                <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <defs>
                        <radialGradient id="pzOrbBase2" cx="35%" cy="28%" r="80%">
                            <stop offset="0%"  stop-color="#ffffff"/>
                            <stop offset="18%" stop-color="#f6efd9"/>
                            <stop offset="50%" stop-color="#d6dec4"/>
                            <stop offset="80%" stop-color="#7e9576"/>
                            <stop offset="100%" stop-color="#3a4f36"/>
                        </radialGradient>
                        <radialGradient id="pzOrbHighlight2" cx="32%" cy="22%" r="22%">
                            <stop offset="0%"  stop-color="#ffffff" stop-opacity="0.95"/>
                            <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
                        </radialGradient>
                    </defs>
                    <circle cx="50" cy="50" r="46" fill="url(#pzOrbBase2)"/>
                    <ellipse cx="38" cy="28" rx="16" ry="9" fill="url(#pzOrbHighlight2)"/>
                </svg>
            </div>

            <div class="pz-kanban pz-reveal">
                @{
                    var stages = new (string NameKey, string Stage, int Count, (string Initials, string Name, string Amt)[] Cards)[] {
                        ("Landing.Pipeline.Stage.NewLead",     "new",       2, new[] { ("AJ", "Alex Johnson", "$2,400"), ("MR", "Maria Rodriguez", "$1,800") }),
                        ("Landing.Pipeline.Stage.Contacted",   "contact",   2, new[] { ("LC", "Liam Chen", "$3,200"), ("SP", "Sara Patel", "$2,750") }),
                        ("Landing.Pipeline.Stage.Qualified",   "qualify",   1, new[] { ("EM", "Emma Müller", "$4,100") }),
                        ("Landing.Pipeline.Stage.Negotiation", "negotiate", 1, new[] { ("DK", "David Kim", "$6,800") }),
                        ("Landing.Pipeline.Stage.Won",         "won",       2, new[] { ("SL", "Sarah Lee", "$5,200"), ("TN", "Tom Nguyen", "$3,900") })
                    };
                }
                @foreach (var s in stages)
                {
                    <div class="pz-kanban__col" data-stage="@s.Stage">
                        <div class="pz-kanban__head">
                            <span>@T[s.NameKey]</span>
                            <span class="pz-kanban__count">@s.Count</span>
                        </div>
                        @foreach (var c in s.Cards)
                        {
                            <div class="pz-kanban__card">
                                <span class="pz-avatar-sm">@c.Initials</span>
                                <div class="pz-kanban__info">
                                    <span class="pz-kanban__name">@c.Name</span>
                                    <span class="pz-kanban__amt">@c.Amt</span>
                                </div>
                                <span class="pz-kanban__dot"></span>
                            </div>
                        }
                    </div>
                }
            </div>

            <aside class="pz-workflow pz-reveal" aria-label="@T["Landing.Pipeline.Workflow.Aria"]">
                <div class="pz-workflow__title">@T["Landing.Pipeline.Workflow.Title"]</div>
                <div class="pz-flow-node">
                    <span class="pz-flow-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 3 14h7v8l10-12h-7V2z"/></svg>
                    </span>
                    <span><strong>@T["Landing.Pipeline.Flow.TriggerLabel"]</strong> @T["Landing.Pipeline.Flow.TriggerBody"]</span>
                </div>
                <span class="pz-flow-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="6 13 12 19 18 13"/></svg>
                </span>
                <div class="pz-flow-node">
                    <span class="pz-flow-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M5 12a7 7 0 0 1 14 0"/></svg>
                    </span>
                    <span><strong>@T["Landing.Pipeline.Flow.AILabel"]</strong> @T["Landing.Pipeline.Flow.AIBody"]</span>
                </div>
                <span class="pz-flow-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="6 13 12 19 18 13"/></svg>
                </span>
                <div class="pz-flow-node">
                    <span class="pz-flow-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3h18v18H3z"/><path d="M8 8h8M8 12h6M8 16h4"/></svg>
                    </span>
                    <span><strong>@T["Landing.Pipeline.Flow.ActionLabel"]</strong> @T["Landing.Pipeline.Flow.Action1Body"]</span>
                </div>
                <span class="pz-flow-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="6 13 12 19 18 13"/></svg>
                </span>
                <div class="pz-flow-node">
                    <span class="pz-flow-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <span><strong>@T["Landing.Pipeline.Flow.ActionLabel"]</strong> @T["Landing.Pipeline.Flow.Action2Body"]</span>
                </div>
            </aside>
        </div>
    </div>
</section>

@* ──────────────────── USE CASES ──────────────────── *@
<section class="pz-section pz-section--tinted" id="use-cases">
    <div class="pz-container">
        <div class="pz-section__head pz-reveal">
            <h2>@T["Landing.UseCases.H2.Part1"] <em>@T["Landing.UseCases.H2.Em"]</em> @T["Landing.UseCases.H2.Part2"]</h2>
            <p>@T["Landing.UseCases.Sub"]</p>
        </div>

        <div class="pz-use__grid">
            @{
                var useCases = new (string TitleKey, string DescKey, string Svg)[] {
                    ("Landing.UseCases.Ecommerce.Title",   "Landing.UseCases.Ecommerce.Desc",
                     "<path d='M3 6h2l2.4 11.4a1.5 1.5 0 0 0 1.5 1.1h8.4a1.5 1.5 0 0 0 1.5-1.1L21 9H6'/><circle cx='9' cy='21' r='1.4'/><circle cx='17' cy='21' r='1.4'/>"),
                    ("Landing.UseCases.RealEstate.Title",  "Landing.UseCases.RealEstate.Desc",
                     "<path d='M3 11 12 3l9 8v9a1.5 1.5 0 0 1-1.5 1.5H4.5A1.5 1.5 0 0 1 3 20v-9z'/><path d='M9 21V13h6v8'/>"),
                    ("Landing.UseCases.Healthcare.Title",  "Landing.UseCases.Healthcare.Desc",
                     "<path d='M12 21s-7-4.5-7-11a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 6.5-7 11-7 11z'/><path d='M9 11h2v-2h2v2h2v2h-2v2h-2v-2H9z' fill='currentColor' stroke='none'/>"),
                    ("Landing.UseCases.Education.Title",   "Landing.UseCases.Education.Desc",
                     "<path d='M2 9l10-5 10 5-10 5L2 9z'/><path d='M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5'/><path d='M22 9v6'/>"),
                    ("Landing.UseCases.Marketing.Title",   "Landing.UseCases.Marketing.Desc",
                     "<path d='M3 11l18-7-3 18-6-9-9-2z'/><path d='M9 12l3 5'/>"),
                    ("Landing.UseCases.Hospitality.Title", "Landing.UseCases.Hospitality.Desc",
                     "<path d='M3 21V8l9-5 9 5v13'/><path d='M9 21V13h6v8'/><path d='M12 8v.01'/>")
                };
            }
            @foreach (var u in useCases)
            {
                <article class="pz-use-card pz-reveal">
                    <span class="pz-use-card__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            @Html.Raw(u.Svg)
                        </svg>
                    </span>
                    <h3>@T[u.TitleKey]</h3>
                    <p>@T[u.DescKey]</p>
                </article>
            }
        </div>

        <div class="pz-testimonial pz-reveal">
            <div class="pz-testimonial__media" role="img" aria-label="Customer success portrait">
                @* Illustrated portrait scene: warm-lit workspace with a person at a laptop *@
                <svg viewBox="0 0 400 320" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <linearGradient id="pzPortraitBg" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%"  stop-color="#e9ddc5"/>
                            <stop offset="60%" stop-color="#cdbf95"/>
                            <stop offset="100%" stop-color="#967f50"/>
                        </linearGradient>
                        <radialGradient id="pzPortraitGlow" cx="30%" cy="25%" r="50%">
                            <stop offset="0%" stop-color="#fff5d6" stop-opacity="0.55"/>
                            <stop offset="100%" stop-color="#fff5d6" stop-opacity="0"/>
                        </radialGradient>
                        <linearGradient id="pzSkin" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%"  stop-color="#f0d4b8"/>
                            <stop offset="100%" stop-color="#c8a07a"/>
                        </linearGradient>
                        <linearGradient id="pzHair" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%"  stop-color="#3b2a1d"/>
                            <stop offset="100%" stop-color="#1d1410"/>
                        </linearGradient>
                        <linearGradient id="pzShirt" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%"  stop-color="#3a4f36"/>
                            <stop offset="100%" stop-color="#1d2a1c"/>
                        </linearGradient>
                        <linearGradient id="pzLaptop" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%"  stop-color="#3a3a3a"/>
                            <stop offset="100%" stop-color="#1a1a1a"/>
                        </linearGradient>
                    </defs>
                    @* warm background *@
                    <rect width="400" height="320" fill="url(#pzPortraitBg)"/>
                    <rect width="400" height="320" fill="url(#pzPortraitGlow)"/>
                    @* window/light bokeh *@
                    <circle cx="60"  cy="60"  r="38" fill="#fff5d6" opacity="0.30"/>
                    <circle cx="120" cy="40"  r="14" fill="#fff5d6" opacity="0.35"/>
                    <circle cx="340" cy="90"  r="22" fill="#fff5d6" opacity="0.20"/>
                    <circle cx="370" cy="180" r="40" fill="#fff5d6" opacity="0.18"/>
                    @* shoulders/torso *@
                    <path d="M70 320 C 80 230, 150 200, 200 200 C 250 200, 320 230, 330 320 Z" fill="url(#pzShirt)"/>
                    @* neck *@
                    <rect x="180" y="170" width="40" height="40" rx="14" fill="url(#pzSkin)"/>
                    @* head *@
                    <ellipse cx="200" cy="140" rx="52" ry="58" fill="url(#pzSkin)"/>
                    @* hair *@
                    <path d="M150 130 C 145 90, 175 70, 200 70 C 230 70, 258 90, 256 130 C 246 110, 224 102, 200 102 C 178 102, 158 110, 150 130 Z" fill="url(#pzHair)"/>
                    <path d="M148 130 C 142 165, 152 200, 175 215 C 172 200, 168 165, 175 145 Z" fill="url(#pzHair)"/>
                    <path d="M252 130 C 258 165, 248 200, 225 215 C 228 200, 232 165, 225 145 Z" fill="url(#pzHair)"/>
                    @* subtle smile/cheeks *@
                    <ellipse cx="180" cy="155" rx="5" ry="2.5" fill="#a87a5b" opacity="0.55"/>
                    <ellipse cx="220" cy="155" rx="5" ry="2.5" fill="#a87a5b" opacity="0.55"/>
                    <path d="M188 167 q 12 8 24 0" stroke="#7a4f33" stroke-width="2.2" fill="none" stroke-linecap="round"/>
                    @* eyes *@
                    <ellipse cx="178" cy="140" rx="3" ry="3.5" fill="#2a1a10"/>
                    <ellipse cx="222" cy="140" rx="3" ry="3.5" fill="#2a1a10"/>
                    <circle cx="179" cy="139" r="1" fill="#fff"/>
                    <circle cx="223" cy="139" r="1" fill="#fff"/>
                    @* eyebrows *@
                    <path d="M170 128 q 8 -4 18 0" stroke="#2a1a10" stroke-width="2.2" fill="none" stroke-linecap="round"/>
                    <path d="M212 128 q 8 -4 18 0" stroke="#2a1a10" stroke-width="2.2" fill="none" stroke-linecap="round"/>
                    @* laptop in front *@
                    <path d="M90 320 L 110 270 H 290 L 310 320 Z" fill="url(#pzLaptop)"/>
                    <rect x="120" y="275" width="160" height="42" rx="4" fill="#2c3a26"/>
                    <rect x="128" y="282" width="60" height="6" rx="2" fill="#aabba4" opacity="0.7"/>
                    <rect x="128" y="294" width="100" height="4" rx="2" fill="#aabba4" opacity="0.45"/>
                    <rect x="128" y="302" width="80" height="4" rx="2" fill="#aabba4" opacity="0.4"/>
                </svg>
            </div>
            <div class="pz-testimonial__body">
                <p class="pz-testimonial__quote">@T["Landing.Testimonial.Quote"]</p>
                <div class="pz-testimonial__meta">
                    <span class="pz-testimonial__stat">@T["Landing.Testimonial.Stat1"]</span>
                    <span>· @T["Landing.Testimonial.Stat2"]</span>
                </div>
                <div class="pz-testimonial__meta">
                    <span class="pz-testimonial__attr">Bloom &amp; Co.</span>
                </div>
            </div>
        </div>
    </div>
</section>

@* ──────────────────── PRICING ──────────────────── *@
<section class="pz-section" id="pricing">
    <div class="pz-container">
        <div class="pz-section__head pz-reveal">
            <h2>@T["Landing.Pricing.H2.Part1"] <em>@T["Landing.Pricing.H2.Em"]</em></h2>
            <p>@T["Landing.Pricing.Sub"]</p>
        </div>

        <div class="pz-price__grid">
            <article class="pz-price-card pz-reveal">
                <div class="pz-price-card__name">@T["Landing.Pricing.Starter.Name"]</div>
                <div class="pz-price-card__price">$19<small>@T["Landing.Pricing.Period"]</small></div>
                <ul>
                    <li>@T["Landing.Pricing.Starter.F1"]</li>
                    <li>@T["Landing.Pricing.Starter.F2"]</li>
                    <li>@T["Landing.Pricing.Starter.F3"]</li>
                    <li>@T["Landing.Pricing.Starter.F4"]</li>
                    <li>@T["Landing.Pricing.Starter.F5"]</li>
                </ul>
                <a class="pz-btn pz-btn--outline pz-btn--xl pz-price-card__cta" href="/Account/Register">@T["Landing.Pricing.Starter.CTA"]</a>
            </article>

            <article class="pz-price-card pz-price-card--feature pz-reveal">
                <span class="pz-price-card__badge">@T["Landing.Pricing.Growth.Badge"]</span>
                <div class="pz-price-card__name">@T["Landing.Pricing.Growth.Name"]</div>
                <div class="pz-price-card__price">$49<small>@T["Landing.Pricing.Period"]</small></div>
                <ul>
                    <li>@T["Landing.Pricing.Growth.F1"]</li>
                    <li>@T["Landing.Pricing.Growth.F2"]</li>
                    <li>@T["Landing.Pricing.Growth.F3"]</li>
                    <li>@T["Landing.Pricing.Growth.F4"]</li>
                    <li>@T["Landing.Pricing.Growth.F5"]</li>
