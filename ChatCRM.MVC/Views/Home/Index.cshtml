                                    break;
                                case "ig":
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
                                    break;
                                case "fb":
                                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.2 2 11.3c0 2.9 1.4 5.5 3.6 7.2v3.5l3.3-1.8c.9.3 1.9.4 3.1.4 5.5 0 10-4.2 10-9.3S17.5 2 12 2zm1 12.4-2.5-2.6-4.9 2.6 5.4-5.7 2.5 2.6 4.9-2.6L13 14.4z"/></svg>
                                    break;
                                case "tg":
                                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.5 4.2 18.7 19c-.2 1-.8 1.2-1.6.8l-4.5-3.3-2.2 2.1c-.2.2-.4.4-.9.4l.3-4.5 8.2-7.4c.4-.3-.1-.5-.5-.2L7.3 13.4l-4.4-1.4c-.9-.3-.9-.9.2-1.4l17.2-6.6c.8-.3 1.5.2 1.2 1.6z"/></svg>
