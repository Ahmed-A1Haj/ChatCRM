                            <span class="pz-inbox-row__avatar" style="background:linear-gradient(135deg,#cfe7f8,#229ed9)"></span>
                        </div>
                        <div class="pz-inbox-row">
                            <span class="pz-inbox-row__icon" style="background:var(--c-tiktok)">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.5 8.5c-1.6 0-3-.6-4.1-1.6V15a5.5 5.5 0 1 1-5.5-5.5v2.8a2.8 2.8 0 1 0 2.8 2.7V3h2.7c.3 1.7 1.4 3 3.2 3.3v2.2z"/></svg>
