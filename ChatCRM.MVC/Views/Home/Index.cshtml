                    ("Facebook Messenger", "Landing.Channels.FacebookMessenger.Desc","#0084ff", "fb"),
                    ("Telegram",           "Landing.Channels.Telegram.Desc",         "#229ed9", "tg"),
                    ("TikTok Business",    "Landing.Channels.TikTokBusiness.Desc",   "#010101", "tt"),
                    ("Email (SMTP/IMAP)",  "Landing.Channels.Email.Desc",            "#ea4335", "em"),
