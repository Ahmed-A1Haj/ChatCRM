@inject Microsoft.Extensions.Localization.IStringLocalizer T
@inject ChatCRM.MVC.Localization.JsonStringLocalizer.ResourceCache LocalizationCache

@{
    Layout = null;
    ViewData["Title"] = T["Audit.Title"].Value;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var translations = LocalizationCache.Load(culture) ?? LocalizationCache.Load("en") ?? new Dictionary<string, string>();
    var translationsJson = System.Text.Json.JsonSerializer.Serialize(translations);
    var htmlLang = culture;
    var htmlDir  = (culture is "ar" or "he" or "fa" or "ur") ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@htmlLang" dir="@htmlDir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ChatCRM</title>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css"  asp-append-version="true" />
    <link rel="stylesheet" href="~/css/billing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/analytics.css" asp-append-version="true" />
    <script>
        window.__i18n__        = @Html.Raw(translationsJson);
        window.__i18nCulture__ = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(culture));
    </script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <style>
        .audit-row-detail { background: var(--bg-soft); padding: 10px; font-family: ui-monospace, monospace; font-size: 11.5px; white-space: pre-wrap; word-break: break-word; border-radius: 6px; }
        .audit-row.is-open td { border-bottom: none; }
        .audit-row-toggle { background: transparent; border: none; cursor: pointer; color: var(--text-muted); padding: 0 6px; font-size: 14px; }
        .audit-row-toggle:hover { color: var(--text); }
    </style>
</head>
<body class="inbox-shell">

@await Html.PartialAsync("_DashboardRail", "audit")

<section class="bill-shell">
    <main class="bill-main">
        <div class="bill-container">
            <header class="bill-page-head">
                <h1 class="bill-page-title">@T["Audit.Title"]</h1>
                <p class="bill-page-sub">@T["Audit.Sub"]</p>
            </header>

            <section class="bill-card">
                <div class="an-filters">
                    <select id="filterAction"><option value="">@T["Audit.Filter.AllActions"]</option></select>
                    <select id="filterEntityType"><option value="">@T["Audit.Filter.AllTypes"]</option></select>
                    <input type="text" id="filterActor" placeholder="@T["Audit.Filter.ActorPlaceholder"]" style="padding: 6px 10px; border: 1px solid var(--border); border-radius: 7px; background: var(--bg-page); font-size: 12.5px;" />
                    <input type="text" id="filterEntityId" placeholder="@T["Audit.Filter.EntityIdPlaceholder"]" style="padding: 6px 10px; border: 1px solid var(--border); border-radius: 7px; background: var(--bg-page); font-size: 12.5px;" />
                    <button type="button" class="auth-btn auth-btn-secondary" id="applyFilters">@T["Audit.Filter.Apply"]</button>
                    <button type="button" class="auth-btn auth-btn-ghost" id="resetFilters">@T["Audit.Filter.Reset"]</button>
                </div>

                <table class="an-log-table" id="auditTable">
                    <thead><tr>
                        <th></th>
                        <th>@T["Audit.Col.When"]</th>
                        <th>@T["Audit.Col.Actor"]</th>
                        <th>@T["Audit.Col.Action"]</th>
                        <th>@T["Audit.Col.EntityType"]</th>
                        <th>@T["Audit.Col.EntityId"]</th>
                    </tr></thead>
                    <tbody></tbody>
                </table>
                <div class="an-log-foot">
                    <button type="button" class="auth-btn auth-btn-ghost" id="prevBtn">@T["Billing.Analytics.Log.Prev"]</button>
                    <span id="pageInfo" class="an-log-info"></span>
                    <button type="button" class="auth-btn auth-btn-ghost" id="nextBtn">@T["Billing.Analytics.Log.Next"]</button>
                </div>
            </section>
        </div>
    </main>
</section>

<script src="~/js/audit.js" asp-append-version="true"></script>
</body>
</html>
