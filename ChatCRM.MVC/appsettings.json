{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ChatCRM;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromEmail": "hicaronacamora@gmail.com",
    "FromName": "ChatCRM"
  },
  "Evolution": {
    "UseMock": true,
    "BaseUrl": "https://your-evolution-instance.example.com",
    "ApiKey": "PUT_IN_appsettings.Development.json",
    "InstanceName": "chatcrm",
    "WebhookSecret": "PUT_IN_appsettings.Development.json"
  },
  "Stripe": {
    "PublishableKey": "PUT_IN_appsettings.Development.json",
    "SecretKey": "PUT_IN_appsettings.Development.json",
    "WebhookSecret": "PUT_IN_appsettings.Development.json",
    "MinAmountUsd": 10,
    "MaxAmountUsd": 1000,
    "Presets": [ 25, 50, 100, 250, 500 ],
    "RateLimitSessionsPerHour": 5
  },
  "Meta": {
    "Graph": {
      "WabaId": "PUT_IN_appsettings.Development.json",
      "AccessToken": "PUT_IN_appsettings.Development.json",
      "ApiBaseUrl": "https://graph.facebook.com",
      "ApiVersion": "v23.0",
      "HttpTimeoutSeconds": 15
    }
  },
  "Ai": {
    "RedisUrl": "localhost:6379",
    "InboundStream": "stream:inbound",
    "OutboundStream": "stream:outbound",
    "ConsumerGroup": "chatcrm-outbound-workers",
    "ConsumerName": "web-1",
    "TenantId": "workspace-1",
    "PublisherPollMilliseconds": 1000,
    "PublisherBatchSize": 50
  }
}
